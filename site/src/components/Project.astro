---
import { readFileSync } from 'node:fs';

import { PHOTOS, PROJECT_PHOTO, photo } from '../lib/photos';

/**
 * «О проекте и организаторах» — блок 10 из pagemap: заголовок, текст и логотипы
 * четырьмя группами (организаторы, партнёры, экспертные организации,
 * государственные структуры).
 *
 * Логотипов у нас нет ни одного, и придумать их нельзя — это чужие товарные
 * знаки. Поэтому группы свёрстаны с пустыми местами: у каждой своя подпись и
 * столько слотов, сколько ожидается участников. Пришёл файл — он ложится в
 * `items` группы, и слот сам становится картинкой; пока не пришёл, на месте
 * логотипа стоит рамка с подписью. Пустая рамка честнее и понятнее заказчику,
 * чем блок, которого на странице не видно вовсе.
 *
 * Тема light — по просьбе заказчика. Следствие, о котором стоит знать:
 * чередование через одну на этом кончается, дальше идут три светлых блока
 * подряд (голосование, этот, футер). Вернуть ритм можно только футером, а не
 * этим блоком.
 *
 * Группа устроена как строка описи, а не как плашка: дивайдер во всю колонку,
 * под ним слева название с описанием роли, справа сами логотипы. Одна строка на
 * группу — четыре подряд читаются перечнем, и порядок в нём и есть иерархия
 * участия.
 *
 * `note` — роль группы, а не факт о ней: ни имён, ни чисел, ни сроков. Всё это
 * приходит от заказчика вместе с логотипами, и подставленное «двенадцать
 * партнёров» пережило бы вёрстку.
 */
/**
 * Кадр в шапке. ВРЕМЕННО это фотография-заглушка (`lib/photos.ts`); ветка с
 * рендером легенды рядом и работает — `PHOTOS = false`. Ширины рендера приходят
 * манифестом: это набор реально собранных файлов, и вписывать их числами нельзя.
 */
const manifest = JSON.parse(
  readFileSync(new URL('../../public/kv/manifest.json', import.meta.url), 'utf8'),
) as { legendWidths: number[] };

const shotWidths = [...manifest.legendWidths].sort((a, b) => a - b);
const shot = PHOTOS
  ? { src: photo(PROJECT_PHOTO), srcset: undefined, sizes: undefined }
  : {
      src: `/kv/legends/bell-${shotWidths[0]}.webp`,
      srcset: shotWidths.map((w) => `/kv/legends/bell-${w}.webp ${w}w`).join(', '),
      sizes: '(max-width: 900px) 40vw, 12rem',
    };

type Logo = { name: string; src: string };
type Group = { label: string; note: string; items: Logo[]; slots: number };

const groups: Group[] = [
  {
    label: 'Организаторы',
    note: 'Ведут конкурс целиком: программа, сроки, отбор финалистов и путь победившей концепции к реализации.',
    items: [],
    slots: 2,
  },
  {
    label: 'Партнёры',
    note: 'Поддерживают конкурс ресурсами и вниманием своей аудитории.',
    items: [],
    slots: 4,
  },
  {
    label: 'Экспертные организации',
    note: 'Разбирают концепции с профессиональной стороны: инженерия, экология, экономика содержания.',
    items: [],
    slots: 3,
  },
  {
    label: 'Государственные структуры',
    note: 'Отвечают за то, что решается не на конкурсе: земля, охранные зоны, транспорт.',
    items: [],
    slots: 2,
  },
];
---

<section class="project u-spacer-top-lg u-spacer-btm-lg" id="project" data-theme="light">
  <div class="u-container">
    <header class="project__head">
      {/* Перенос стоит в разметке: две строки — композиция шапки, а `text-wrap`
          делит строку по-своему на каждой ширине. Слов с «й» здесь нет и быть не
          может: у дисплейного стиля интерлиньяж 0.9 и trim по кап-высоте, краткая
          в него не помещается ни в первой строке, ни во второй. */}
      <h2 class="project__title u-text-style-display u-alignment-center">
        Архитектура<br />уважения
      </h2>
      <hr class="rule rule--loose" />

      {/* Оба абзаца стоят в правой колонке друг под другом и одним цветом: это две
          части одной мысли — что за проект и почему решение общее, — и разводить их
          цветом или кеглем значило бы делать из второй сноску.

          В левой колонке остаётся место, и в нём стоит кадр в треть колонки. `alt`
          пустой намеренно: это заглушка, а не съёмка берега, и описать её как берег
          значило бы соврать в самом доступном слое. */}
      <div class="project__lead">
        <div class="photo project__shot">
          <img {...shot} alt="" loading="lazy" decoding="async" />
        </div>

        <div class="project__texts">
          <p class="project__text u-text-style-text-lg u-text-main">
            Проект объединяет бизнес, архитектурное сообщество, экспертов и жителей
            вокруг общей задачи — сохранить характер Порта Байкал и создать
            пространство, которое будет жить вместе с территорией.
          </p>
          <p class="project__text u-text-style-text-lg u-text-main">
            Поэтому конкурс идёт не в закрытом жюри: концепции финалистов выносятся
            на общее голосование, а решение принимается вместе с теми, кто на этом
            берегу живёт и работает.
          </p>
        </div>
      </div>
    </header>

    {/* Каждая группа — строка описи: дивайдер во всю колонку, слева название с
        описанием роли, справа логотипы. Дивайдер стоит в самой строке, поэтому
        своей линии под шапкой блока нет — первая же линия группы её и отбивает. */}
    <div class="orgs">
      {groups.map((g) => (
        <div class="orgs__group">
          <hr class="rule" />
          <div class="orgs__body">
            <h3 class="orgs__label u-text-style-h6">{g.label}</h3>
            <p class="orgs__note u-text-style-text-sm u-text-muted">{g.note}</p>
          </div>
          <ul class="orgs__row">
            {g.items.length > 0
              ? g.items.map((l) => (
                  <li class="logo">
                    <img class="logo__img" src={l.src} alt={l.name} loading="lazy" decoding="async" />
                  </li>
                ))
              : Array.from({ length: g.slots }).map(() => (
                  <li class="logo logo--empty">
                    <span class="logo__stub u-text-style-eyebrow-xs u-text-tertiary">логотип</span>
                  </li>
                ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Отступы поштучно каждому элементу, а не сбросом `.project p`: сброс на теге
     специфичнее классов и съедает их собственные margin, а текст набран с
     вертикальным trim и без отступа встаёт кап-высотами вплотную. */
  /* Блок начинается заголовком: надзаголовков над h2 на странице нет ни в одной
     секции — заказчик их снял. Отступ сверху даёт спейсер секции. */
  .project__title {
    margin: 0;
  }

  /* Те же две равные дорожки, что у строк групп ниже: слева кадр, справа оба
     абзаца. Дорожки `minmax(0, 1fr)`, а не `1fr`: у `1fr` минимум равен min-content,
     и длинное слово справа растянуло бы свою дорожку, сделав половины разными.

     Мера стоит на самих абзацах, а не на обёртке: `ch` считается по кеглю элемента,
     и на обёртке то же число дало бы другую ширину.

     Своего отступа сверху у лида нет: его отбивает дивайдер шапки, а его поля общие
     для всего сайта. Второе число здесь означало бы, что расстояние под линией живёт
     в двух местах. */
  .project__lead {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: start;
  }

  /* Кадр в треть своей колонки — процентом, а не в rem: «треть колонки» и есть
     требование, а колонка меняется вместе с шириной страницы. Пропорция стоит на
     боксе: картинка внутри лежит абсолютом и своей высоты боксу не отдаёт. Бокс
     `.photo` режет кадр по форме, а картинка идёт в нём параллаксом за прокруткой —
     тот же ход, что у остальных кадров страницы. */
  .project__shot {
    inline-size: 33%;
    aspect-ratio: 3 / 4;
  }

  .project__texts {
    grid-column: 2;
  }

  /* Выключка по формату — общая для всей страницы. Мера в `ch` считается по кеглю
     самого абзаца, поэтому при переходе на крупный кегль число знаков в строке
     остаётся тем же, а колонка становится шире сама. */
  .project__text {
    max-inline-size: 46ch;
    margin: 0;
    text-align: justify;
  }

  /* Отбивка между абзацами — крупный шаг, и это не вкус: набор идёт с вертикальным
     trim, бокс обжат по кап-высоте, и на мелком отступе два абзаца читаются одним. */
  .project__text + .project__text {
    margin-block-start: var(--space-2xl);
  }

  /* Четыре группы стопкой: каждая — своя строка описи с дивайдером сверху.
     Междурядье крупное — иначе линия следующей группы читается частью предыдущей,
     а не началом новой. Опись отбита от шапки вдвое сильнее, чем группы друг от
     друга: шаги шкалы подобраны так, что это ровно вдвое и ровно в полтора раза от
     прежнего (замер на 1440: было 64 px и там и там, стало 128 сверху и 96 между
     группами). Числа остаются шагами шкалы, а не подобранными пикселями. */
  .orgs {
    display: grid;
    row-gap: var(--space-7xl);
    margin-block-start: var(--space-8xl);
  }

  /* Внутри строки те же две дорожки, что у лида: слева название с описанием,
     справа логотипы. Дивайдер лежит поверх обеих — отбивки у него общие для всего
     сайта, поэтому своего гэпа над содержимым строке не нужно. */
  .orgs__group {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: start;
  }

  /* Линия группы вторая по силе: приглушённый цвет вместо `--border`. Иерархия
     здесь и держится — линия под шапкой блока одна и основная, линий групп четыре,
     и в полную силу они спорили бы с ней и делили блок на пять равных частей.

     Ступень взята `--muted-secondary`, а не `--muted`: на `--muted` (0.64) линия в
     один пиксель от основной на глаз не отличается вовсе — приглушение видно в
     тексте, но не в линии. На 0.4 разница читается. Цвет семантический, поэтому в
     другой теме он поедет вместе с ней. */
  .orgs__group > .rule {
    grid-column: 1 / -1;
    background: var(--muted-secondary);
  }

  .orgs__label {
    margin: 0 0 var(--space-md);
  }

  /* Описание роли уже названия по мере: строка в полколонки читается подписью к
     названию, а не вторым абзацем блока. */
  .orgs__note {
    max-inline-size: 42ch;
    margin: 0;
  }

  .orgs__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Геометрия слота — как у мишени светлячка: своё число в компоненте, потому что
     это размер элемента, а не отступ из шкалы. Пропорция взята под горизонтальный
     знак с подписью; вертикальные лягут по высоте и останутся уже слота. */
  .logo {
    display: grid;
    place-items: center;
    inline-size: 9rem;
    aspect-ratio: 12 / 5;
  }

  .logo__img {
    max-inline-size: 100%;
    max-block-size: 100%;
    object-fit: contain;
  }

  /* Пустое место под логотип: рамка пунктиром — она читается ожидающим слотом, а
     не элементом дизайна, и её ни с чем не спутать при приёмке. */
  .logo--empty {
    border: 1px dashed var(--muted-tertiary);
  }

  .logo__stub {
    display: block;
  }

  @media (max-width: 900px) {
    /* Обе пары дорожек складываются в одну: половина колонки уже меры абзаца, и
       текст в ней рвётся по слову. Порядок чтения тот же, что в разметке —
       переставлять нечего.

       Междурядья у строки группы нет намеренно: отбивку под дивайдером держат его
       собственные поля, общие для всего сайта, а логотипы отбиваются своим. */
    .project__lead,
    .orgs__group {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Дорожки нет — значит нет и второй: текст встаёт под кадром сам. */
    .project__texts {
      grid-column: 1;
      margin-block-start: var(--space-2xl);
    }

    /* Кадр в одной колонке считается от всей её ширины, поэтому доля крупнее: треть
       узкой колонки читается уже не кадром, а иконкой. По центру — по той же оси,
       что дисплейный заголовок и дивайдер над ним: прижатый к левому краю кадр
       под центрированной шапкой читается сбитым. */
    .project__shot {
      inline-size: 45%;
      margin-inline: auto;
    }

    /* Абзацам центрируется бокс, а не строки: выключка по формату остаётся. Мера
       в `ch` уже колонки, поэтому без автополей набор стоял бы левее оси блока. */
    .project__text {
      margin-inline: auto;
    }

    .orgs__row {
      margin-block-start: var(--space-xl);
    }
  }

  @media (max-width: 560px) {
    .orgs {
      row-gap: var(--space-3xl);
    }

    /* Слот ужимается вместе с колонкой: два по 9rem в 390 px не встают. */
    .logo {
      inline-size: min(9rem, 40vw);
    }
  }
</style>
