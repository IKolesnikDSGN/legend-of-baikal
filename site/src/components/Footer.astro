---
/**
 * Футер — блок 11 из pagemap: логотип проекта, разделы сайта, контакты и
 * юридические ссылки.
 *
 * Ростом в экран и в тёмной теме — по просьбе заказчика. Тема заодно возвращает
 * ритм страницы: «О проекте» светлый, футер тёмный, и граница между ними не
 * требует линии — её рисует сам цвет.
 *
 * Разбит на две части. Сверху подпись проекта и навигация; снизу, по нижней
 * кромке экрана, — крупный леттеринг во всю ширину страницы за вычетом полей, а
 * над ним строка выходных данных: копирайт слева, разработка справа. Дивайдера в
 * футере нет вовсе: части разводит пустое место, а не линия.
 *
 * Дисклеймера о художественной интерпретации легенд здесь тоже больше нет —
 * заказчик его снял.
 *
 * Капители в подписях нет ни в одной: и леттеринг, и названия колонок набраны как
 * написаны. Это решение заказчика, а не свойство стиля, поэтому `u-transform-none`
 * стоит поверх стиля заголовка, а сам стиль не тронут.
 *
 * Контактов и соцсетей у нас нет, и адрес из головы хуже пустого места: письмо по
 * нему уйдёт в никуда. Поэтому там стоит «уточняется» — та же договорённость, что
 * у фактов конкурса и даты голосования. Ссылки на положение, политику и юридическую
 * информацию ведут на страницы, которых ещё нет, — как «Подробнее» в карточке
 * легенды.
 *
 * Год в копирайте берётся на сборке: статика пересобирается при каждой правке
 * контента, и вписанное число разъедется с ней молча.
 */
const year = new Date().getFullYear();

/** Леттеринг нижней части. Строка живёт здесь одна: по числу её знаков подобран
    делитель кегля (см. стили), и менять одно без другого нельзя. */
const WORDMARK = 'Legend of Baikal';

const nav = [
  {
    label: 'Конкурс',
    links: [
      { text: 'О конкурсе', href: '/#about' },
      { text: 'Положение о конкурсе', href: '/competition/rules' },
      { text: 'Подать заявку', href: '/apply' },
    ],
  },
  {
    label: 'Проект',
    links: [
      { text: 'О территории', href: '/#territory' },
      { text: 'Голосование', href: '/#voting' },
      { text: 'Организаторы', href: '/#project' },
    ],
  },
  {
    label: 'Документы',
    links: [
      { text: 'Политика обработки персональных данных', href: '/privacy' },
      { text: 'Юридическая информация', href: '/legal' },
    ],
  },
];
---

<footer class="footer u-spacer-top-md u-spacer-btm-md" data-theme="brand">
  {/* Обёртка содержимого едет за прокруткой, поэтому она одна на обе части: две
      обёртки с одним ходом разъехались бы на первой же правке амплитуды. */}
  <div class="footer__in">
    <div class="footer__top">
      <div class="footer__brand">
        {/* Леттеринг тот же, что в хедере первого экрана, и тем же стилем: это одна
            подпись проекта, а не два разных логотипа. Капитель снята — заказчик
            убрал её во всех подписях футера. */}
        <p class="footer__logo u-text-style-h6 u-transform-none">Legend of Baikal</p>
        <p class="footer__tagline u-text-style-text-sm u-text-muted">
          Открытый конкурс концепций благоустройства берега Порта Байкал
        </p>
      </div>

      <nav class="footer__nav" aria-label="Разделы сайта">
        {nav.map((col) => (
          <div class="footer__col">
            <p class="footer__col-label u-text-style-text-sm u-text-secondary">{col.label}</p>
            <ul class="footer__list">
              {col.links.map((l) => (
                <li>
                  <a class="footer__link u-text-style-text-sm u-weight-semibold" href={l.href}>
                    {l.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div class="footer__col">
          <p class="footer__col-label u-text-style-text-sm u-text-secondary">Связь</p>
          <ul class="footer__list">
            {/* Адрес из головы хуже пустого места: письмо по нему уйдёт в никуда.
                Строки короткие намеренно — в колонку по 24 ch они встают в одну,
                а «Контакты организаторов — уточняются» рвалось посреди фразы. */}
            <li class="footer__pending u-text-style-text-sm u-text-muted">
              Контакты — уточняются
            </li>
            <li class="footer__pending u-text-style-text-sm u-text-muted">
              Соцсети — уточняются
            </li>
          </ul>
        </div>
      </nav>
    </div>

    {/* Нижняя часть стоит по кромке экрана и живёт вне колонки страницы: леттеринг
        идёт во всю ширину за вычетом полей сайта, и выходные данные над ним встают
        по тем же краям. */}
    <div class="footer__end">
      <div class="footer__meta">
        <p class="footer__copy u-text-style-text-sm u-text-muted">© {year} Legend of Baikal</p>
        <p class="footer__made u-text-style-text-sm u-text-muted">Разработка сайта</p>
      </div>
      <p class="footer__word">{WORDMARK}</p>
    </div>
  </div>
</footer>

<style>
  /* Ростом в экран: `100svh`, а не `vh`, — на мобильных `vh` считается по свёрнутой
     панели браузера, и футер вылезал бы за экран на её высоту. Это минимум, а не
     фиксированная высота: на коротком экране содержимое растит футер.

     Две строки сетки: верхняя тянется, нижняя встаёт по своей высоте, поэтому
     леттеринг всегда стоит у нижней кромки, а навигация — у верхней.

     `overflow: clip` держит наплыв содержимого: на входе оно сдвинуто вверх и
     обязано быть обрезано кромкой футера, а не висеть над блоком «О проекте». */
  .footer {
    display: grid;
    min-block-size: 100svh;
    overflow: clip;
  }

  .footer__in {
    display: grid;
    grid-template-rows: 1fr auto;
    row-gap: var(--space-6xl);
  }

  /* Логотип с подписью слева, навигация справа — обычная раскладка футера. Свой
     грид, а не u-grid-12: колонок здесь не двенадцать, а «подпись проекта» и
     «ссылки», и вторая обязана прижиматься к правому краю.

     Колонки страницы у футера нет вовсе: обе его части идут во всю ширину экрана
     за вычетом полей сайта — те же `--margin`, что у `u-container`, но без потолка
     `--page-max`. Иначе на экране шире 1920 верх стоял бы колонкой по центру, а
     леттеринг внизу — от края до края, и левые кромки двух частей разъехались бы. */
  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: start;
    gap: var(--space-6xl) var(--gutter);
    padding-inline: var(--margin);
  }

  .footer__logo {
    margin: 0 0 var(--space-md);
  }

  .footer__tagline {
    max-inline-size: 32ch;
    margin: 0;
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6xl);
  }

  .footer__col-label {
    margin: 0 0 var(--space-md);
  }

  /* Потолок ширины колонки — то же число, что у мини-плашки первого экрана.
     Сейчас в него не упирается никто: самая длинная ссылка, политика обработки
     данных, встаёт в одну строку. Он стоит на будущее — колонка, которая тянется
     за своей самой длинной ссылкой, расталкивает соседние к краям страницы.

     Междурядье втрое... нет, ровно в полтора раза меньше прежнего шага — по
     просьбе заказчика. Множитель от того же шага шкалы, а не новое число: «в
     полтора раза» остаётся собой и после правки шкалы. */
  .footer__list {
    display: grid;
    gap: calc(var(--space-2xs) / 1.5);
    max-inline-size: 18rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Ссылки в футере набраны без подчёркивания, но с ним под курсором: столбец
     подчёркнутых строк читается сплошной штриховкой. */
  .footer__link {
    text-decoration: none;
  }

  .footer__link:hover,
  .footer__link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .footer__pending {
    max-inline-size: 24ch;
  }

  /* ── нижняя часть ─────────────────────────────────────────────────────────── */
  /* Поля те же `--margin`, что у колонки страницы, но потолка `--page-max` здесь
     нет: леттеринг обязан идти во всю ширину экрана за вычетом полей. Тот же приём,
     что у «О конкурсе».

     `container-type` нужен леттерингу: его кегль считается от ширины этой части, а
     не от вьюпорта, — иначе поля в расчёт не попадут. */
  .footer__end {
    container-type: inline-size;
    padding-inline: var(--margin);
  }

  /* Выходные данные: копирайт слева, разработка справа. Строка стоит над
     леттерингом и по его краям — это одна пара кромок, а не две разные. */
  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs) var(--gutter);
    margin-block-end: var(--space-md);
  }

  .footer__copy,
  .footer__made {
    margin: 0;
  }

  /* Леттеринг во всю ширину. Кегль считается от ширины полосы в `cqw`, а не задан
     числом: делитель — это ширина самой строки в кеглях, и он замерен под эту
     строку, эту гарнитуру и капитель (8.66 em на «LEGEND OF BAIKAL»). Поэтому
     краска занимает полосу целиком на любой ширине: и кегль, и ширина строки
     линейны по `cqw`. Поменяешь строку, трекинг, вес или капитель — пересчитывай
     делитель, иначе леттеринг вылезет за поле или не дойдёт до края.

     Капитель здесь и есть набор: заказчик снял её у подписей футера и оставил у
     леттеринга. Интерлиньяж 1 и вертикальный trim по кап-высоте: строка обязана
     стоять по нижней кромке футера без полупустого поля шрифта под ней. */
  .footer__word {
    margin: 0;
    font-size: calc(100cqw / 8.66);
    line-height: 1;
    font-weight: var(--weight-medium);
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  /* ── наплыв содержимого за прокруткой ─────────────────────────────────────── */
  /* Содержимое футера выезжает сверху и доходит до места ровно тогда, когда футер
     дошёл до низа: диапазон `entry` кончается в момент, когда нижняя кромка футера
     встаёт на нижнюю кромку экрана, а он последний на странице — то есть в самом
     конце прокрутки. Дальше ход стоит, потому что и прокрутка кончилась.

     Прогресс считает браузер по `view()`-таймлайну: своего слушателя скролла нет
     намеренно — рядом с Lenis он был бы вторым и на каждый кадр. Без таймлайна
     содержимое просто стоит на месте: та же анимация по обычному времени уехала бы
     в свой конец насовсем. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .footer__in {
        --footer-drift: 12svh;

        animation-name: footer-rise;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }
    }
  }

  @keyframes footer-rise {
    from {
      translate: 0 calc(var(--footer-drift) * -1);
    }

    to {
      translate: 0 0;
    }
  }

  @media (max-width: 900px) {
    /* Навигация уезжает под подпись проекта, а не жмётся к ней вторым столбцом. */
    .footer__top {
      grid-template-columns: minmax(0, 1fr);
    }

    .footer__nav {
      gap: var(--space-3xl);
    }
  }
</style>
