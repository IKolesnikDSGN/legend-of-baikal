---
import { readFileSync } from 'node:fs';

import TerritoryStory from './TerritoryStory.astro';
import { CLOSING, OBJECT_PHOTOS, PANORAMA, PHOTOS, photo } from '../lib/photos';

/**
 * «О территории» — первый контентный блок после сцены (pagemap, блок 7).
 *
 * Задача блока из pagemap: показать, что конкурс привязан к реальному месту с
 * реальной перспективой преобразования, а не является брендовой активацией.
 * Отсюда состав: география, историческая роль, ключевые объекты, проблемы и
 * потенциал, панорама.
 *
 * Тема light стоит на самой секции. Секция и есть выход из сцены: последний экран
 * пина она поднимается снизу обычным скроллом, а открывает её сама сцена — фронт
 * финального наплыва снимает канвас в прозрачность. Пин отпускает ровно там, где
 * секция встала по верхней кромке, поэтому шва между кадром и страницей нет.
 * Механика перекрытия — в стилях ниже и в `hero/scroll.ts`.
 *
 * Стилистика взята с первого экрана: надзаголовок, заголовок по центру, дивайдер
 * во всю колонку и три подписи в строку под ним — тот же ход, что у h1 с
 * hero__notes. Той же идиомой открыт и блок ключевых объектов, а под его
 * дивайдером стоят две колонки: список названий справа, кадр с описанием слева.
 *
 * Цифр в тексте нет намеренно, по той же причине, что и в карточке `factory`:
 * фактология территории приходит от заказчика, а подставленное «примерно
 * столько» переживёт вёрстку и уедет в продакшн.
 */

/** Место под видео — заглушка: готовый кроп кей-вижуала из пайплайна. Своего
    файла здесь нет и не появится руками — придёт съёмка территории заказчика, и
    это ровно замена источников внутри того же бокса.

    Форма бокса 16:9 — формат будущего видео, и она задана в стилях числом. Это
    не пропорция кропа: доли кропов живут в `kv/config.py` и приезжают манифестом,
    а эта приходит от контента, которого ещё нет. Заглушка ложится в неё
    обрезкой, а не наоборот, — иначе подмена файла двинула бы весь текст ниже.

    Кроп один на все ширины — fullbleed 1.6:1: в 16:9 он закрывает бокс целиком,
    теряя по краю сверху и снизу. Арт-дирекшна больше нет вовсе, летбокс 2.8:1
    здесь не годится ни на какой ширине — в этом боксе ему срезало бы треть
    ширины кадра.

    Из манифеста остаются ширины: они и есть набор реально собранных файлов. */
const manifest = JSON.parse(
  readFileSync(new URL('../../public/kv/manifest.json', import.meta.url), 'utf8'),
) as { cropWidths: number[]; legendWidths: number[] };

const widths = [...manifest.cropWidths].sort((a, b) => a - b);
const srcset = (ext: string) => widths.map((w) => `/kv/kv-fullbleed-${w}.${ext} ${w}w`).join(', ');

/** Опорная ширина — средняя из манифеста: она же в `src` как фолбэк. */
const base = widths[Math.floor(widths.length / 2)];

/** Кадры карточек — те же заглушки, что в сцене выше: рендеры легенд из
    пайплайна. Фотографий территории нет ни одной, и придумать их нельзя.
    Соответствие не случайное — рендер каждой легенды сделан вокруг своего
    объекта (`legends[].object` в манифесте), поэтому на месте причальной стенки
    стоит ангар на пирсе, а на месте истока — открытая вода. Придёт съёмка —
    меняется `shot`, вся остальная карточка остаётся.

    Ширины приходят манифестом: это набор реально собранных файлов. */
const shotWidths = [...manifest.legendWidths].sort((a, b) => a - b);
const shotSrcset = (id: string) =>
  shotWidths.map((w) => `/kv/legends/${id}-${w}.webp ${w}w`).join(', ');

/** Ключевые объекты. Список названий стоит справа, кадр с описанием — слева, и
    меняется он по наведению на название. Своей геометрии у объекта поэтому нет
    вовсе: все кадры лежат в одной ячейке одного размера, а разница между ними
    только в том, какой сейчас показан. */
type Obj = { title: string; text: string; shot: string };

const objects: Obj[] = [
  {
    title: 'Кругобайкальская дорога',
    text: 'Тоннели, виадуки и каменные галереи начала века. Линия начинается прямо от посёлка и дальше идёт по берегу.',
    shot: 'railway',
  },
  {
    title: 'Причальная стенка',
    text: 'Стык воды и рельсов, ради которого порт и построили: сюда приходили паромы с составами на борту.',
    shot: 'factory',
  },
  {
    title: 'Паромная переправа',
    text: 'Единственная регулярная связь с Листвянкой и трассой на Иркутск. Зимой её место занимает лёд.',
    shot: 'ice-road',
  },
  {
    title: 'Посёлок и депо',
    text: 'Деревянная застройка вдоль берега, служебные постройки порта и депо — почти без поздних надстроек.',
    shot: 'bell',
  },
  {
    title: 'Исток Ангары',
    text: 'Единственная река, вытекающая из Байкала, начинается прямо напротив посёлка: берег стоит на самом стыке озера и её русла.',
    shot: 'epishura',
  },
];
---

<section class="territory u-spacer-top-lg u-spacer-btm-lg" id="territory" data-theme="light">
  <div class="u-container">
    <header class="territory__head">
      <h2 class="territory__title u-text-style-display u-alignment-center">Берег в истоке<br>Ангары</h2>
      <hr class="rule" />
      {/* Три подписи в строку — та же сетка, что у подписей первого экрана:
          «слева», «по центру», «справа», а не доли макетной сетки. */}
      <div class="territory__notes">
        <p class="territory__note u-text-style-text-sm u-weight-semibold">
          Левый берег истока Ангары, напротив Листвянки
        </p>
        <p class="territory__note u-text-style-text-sm u-weight-semibold u-alignment-center">
          Начало Кругобайкальской железной дороги
        </p>
        <p class="territory__note u-text-style-text-sm u-weight-semibold u-alignment-right">
          Паром и рельсы — вся связь с внешним миром
        </p>
      </div>
    </header>

    {/* Место под видео. Форма держится в CSS, а не атрибутами width/height:
        атрибуты описывают файл, который лежит внутри, а бокс обязан стоять
        16:9 — и до загрузки, и после подмены заглушки на съёмку.

        Бокс — `.photo`: он режет кадр по форме, а картинка внутри выше его и
        идёт параллаксом за прокруткой (`styles/photos.css`). */}
    <figure class="territory__media">
      {PHOTOS ? (
        <div class="photo media__box">
          <img
            src={photo(PANORAMA)}
            alt="Каменистый берег большого озера и дальняя гряда за водой"
            loading="lazy"
            decoding="async"
          />
        </div>
      ) : (
        <picture class="photo media__box">
          <source srcset={srcset('avif')} type="image/avif" />
          <img
            src={`/kv/kv-fullbleed-${base}.webp`}
            srcset={srcset('webp')}
            sizes="100vw"
            alt="Панорама Порта Байкал: посёлок вдоль берега, причал, насыпь железной дороги и маяк на скале"
            loading="lazy"
            decoding="async"
          />
        </picture>
      )}
      {/* Подпись лежит оверлеем на кадре и разнесена по его краям: слева — что
          это, справа — статус заглушки. Стики держит её по центру экрана, пока
          кадр идёт мимо, и отпускает на его нижней кромке. */}
      <figcaption class="territory__caption u-text-style-text-sm u-weight-semibold u-text-highlights">
        <span>Панорама берега</span>
        <span>{PHOTOS ? 'Фотография-заглушка до съёмки на месте' : 'Кадр кей-вижуала стоит здесь до съёмки на месте'}</span>
      </figcaption>
    </figure>
  </div>

  {/* Сцена с двумя подблоками текста стоит вне колонки страницы: колонку держит
      сам набор, а кадры вокруг него идут во всю ширину экрана. */}
  <TerritoryStory />

  <div class="u-container">
    <div class="territory__objects">
      {/* Заголовок стоит меткой над дивайдером: мелкий кегль по левому краю, а не
          крупный по центру, — блок открывает не он, а список названий под ним.
          Расстояния над дивайдером и под ним равны: линия принадлежит обеим
          половинам сразу, и любой перекос читается прижатой к чему-то одному. */}
      <h3 class="objects__title u-text-style-h5 u-alignment-left">Ключевые объекты</h3>
      <hr class="rule rule--loose" />
      {/* Список названий справа, кадр с описанием слева. Пара «название — кадр»
          лежит в разметке рядом (`li` раскрыт `display: contents`), а по колонкам
          её разводит сетка: так порядок чтения остаётся человеческим, а на узком
          экране объект собирается обратно в карточку без единой перестановки.

          `--rows` — число объектов, а не подобранная величина: кадр обязан
          спанить все строки списка, а `1 / -1` требует явных строк. */}
      <ol class="objects" style={`--rows:${objects.length}`} data-objects>
        {objects.map((o, i) => (
          <li class={`obj${i === 0 ? ' is-active' : ''}`}>
            {/* Кнопка, а не строка: она переключает показанный кадр, и с
                клавиатуры это обязано работать так же, как мышью. Описание
                привязано к ней явно — иначе с экранного диктора список названий
                и стопка описаний читаются двумя несвязанными кусками. */}
            <button class="obj__pick u-text-style-h2" type="button" aria-describedby={`obj-${o.shot}`}>
              {o.title}
            </button>
            <figure class="obj__view">
              {/* alt пустой намеренно: это заглушка, а не фотография объекта, и
                  описать её как берег значило бы соврать в самом доступном слое.
                  Что показано — говорят название и описание. */}
              <div class="photo obj__box">
                <img
                  class="obj__img"
                  src={PHOTOS ? photo(OBJECT_PHOTOS[o.shot]) : `/kv/legends/${o.shot}-${shotWidths[0]}.webp`}
                  srcset={PHOTOS ? undefined : shotSrcset(o.shot)}
                  sizes={PHOTOS ? undefined : '(max-width: 900px) 100vw, 40vw'}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="obj__text u-text-style-text-md u-text-muted" id={`obj-${o.shot}`}>
                {o.text}
              </figcaption>
            </figure>
          </li>
        ))}
      </ol>
    </div>

    {/* Закрывающая мысль блока: она же переход к «О конкурсе». Линий здесь нет ни
        одной — ни над блоком, ни внутри: дисплейный заголовок начинает его сам, а
        своей ссылки у него нет, потому что условия открывает кнопка блока ниже.

        Слева заголовок дисплейным кеглем, справа кадр. Заголовок стоит по верхней
        кромке, текст — по нижней: высоту ряда задаёт кадр, и низ обеих колонок
        обязан сойтись. */}
    <div class="territory__closing">
      <div class="closing__body">
        <h3 class="closing__title u-text-style-h2">
          Проблема и потенциал — одно и то же
        </h3>
        <div class="closing__text">
          <p class="territory__text u-text-style-text-md">
            Берег сохранился потому, что им не занимались: тупиковая ветка
            законсервировала посёлок целиком — вместе с депо, причальной стенкой и
            деревянными домами. У этой сохранности есть обратная сторона. Здания
            ветшают быстрее, чем находят применение, инфраструктуры для приезжающих
            почти нет, а поток людей уже есть — и он проходит мимо: паром и поезд
            привозят и увозят в один день, потому что остаться здесь негде.
          </p>
          <p class="territory__text u-text-style-text-md">
            Конкурс про это: не построить новое поверх старого, а достроить то, чего
            берегу не хватает, чтобы им можно было пользоваться круглый год. Задача
            не в объёме, а в точности — место читается целиком, и любая постройка
            встаёт в уже сложившийся кадр рядом с рельсами, водой и старой
            застройкой. Поэтому от участников ждут не образ, а работающее решение:
            что здесь делать зимой, в межсезонье и в тот день, когда паром не идёт.
          </p>
        </div>
      </div>
      {/* Тот же статус, что у остальных кадров страницы: рендер легенды вместо
          съёмки, которой ещё нет. Маяк — единственный, не занятый в объектах
          выше: повтор на одном экране прочитался бы ошибкой вёрстки. */}
      <figure class="closing__media">
        <div class="photo closing__box">
          <img
            src={PHOTOS ? photo(CLOSING) : `/kv/legends/lighthouse-${shotWidths[0]}.webp`}
            srcset={PHOTOS ? undefined : shotSrcset('lighthouse')}
            sizes={PHOTOS ? undefined : '(max-width: 900px) 100vw, 40vw'}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  /* ── выход из сцены ─────────────────────────────────────────────────────── */
  /* Секция поднята на высоту сцены и весь её финальный экран едет снизу вверх
     обычным скроллом — своей анимации у этого движения нет вовсе, это и есть
     прокрутка. Открывает секцию сама сцена: фронт последнего наплыва снимает
     канвас в прозрачность, и в дыру видно то, что здесь уже приехало. Пин
     отпускает ровно там, где секция встала по верхней кромке, поэтому шва и
     скачка между сценой и страницей нет.

     Атрибут ставит сцена (`hero/scroll.ts`) и только в режиме WebGL: без канваса
     открывать нечего, и наезд превратился бы в подмену кадра без перехода.
     Высота — та же `--hero-h`, которой живёт первый экран: второе число здесь
     разъехалось бы с длиной финального слота, и пин отпускал бы секцию не там,
     где она доехала.

     z-index: 0 обязателен вместе с position: relative — секция стоит в разметке
     после сцены, и позиционированная без своего слоя она легла бы поверх
     канваса, накрыв кадр вместо того, чтобы открыться из-под него. */
  :global(:root[data-hero-overlap]) .territory {
    position: relative;
    z-index: 0;
    margin-block-start: calc(var(--hero-h) * -1);
  }

  /* Фон секции над её собственной кромкой. Фронт наплыва рваный, с разбросом по
     высоте в 0.85 экрана, и его острова уходят выше того места, куда секция уже
     доехала: без этого поля в них просвечивал бы фон страницы с рампы KV, то
     есть тёмное пятно поверх открывшейся светлой секции. */
  :global(:root[data-hero-overlap]) .territory::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 100%;
    block-size: var(--hero-h);
    background: var(--bg);
  }

  /* Между частями блока — один ритм. Отступы поштучно каждому элементу, а не
     сбросом `.territory p`: сброс на теге специфичнее классов и молча съедает
     их собственные margin, а весь текст набран с вертикальным trim и без
     отступа встаёт кап-высотами вплотную. */
  /* Блок начинается заголовком: надзаголовков над h2 на странице нет ни в одной
     секции — заказчик их снял. Отступ сверху даёт спейсер секции. */
  .territory__title {
    margin: 0;
  }

  .territory__notes {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    gap: var(--gutter);
  }

  .territory__note {
    margin: 0;
  }

  /* Кадр и подпись лежат в одной ячейке сетки: подпись обязана быть оверлеем и
     при этом остаться в потоке — стики абсолютным элементам недоступен. Высоту
     ячейки задаёт кадр, подпись в неё только вписывается. */
  .territory__media {
    display: grid;
    margin: var(--space-6xl) 0 0;
  }

  .territory__media > * {
    grid-area: 1 / 1;
  }

  /* Бокс 16:9 на всех ширинах — это формат видео, которое здесь встанет, а не
     пропорция лежащей внутри заглушки. Число поэтому здесь, а не из манифеста:
     доли кропов приезжают им, а эта приходит от контента.

     Заглушка ложится в него обрезкой (`object-fit` в `styles/photos.css`): её
     пропорция другая, и без обрезки она растянулась бы в бокс шире себя.

     Пропорция стоит на боксе, а не на картинке: внутри бокса картинка выше его
     на запас параллакса, и оставь пропорцию ей — бокс поехал бы за её высотой,
     то есть форма 16:9 разъехалась бы вместе с амплитудой хода. */
  .media__box {
    aspect-ratio: 16 / 9;
  }

  /* ── раскрытие панорамы прокруткой ──────────────────────────────────────── */
  /* Кадр открывается из своего центра в обе стороны и доходит до полного ровно
     к тому моменту, когда его верхняя кромка встаёт под верхнюю кромку экрана.
     Дальше он просто стоит открытым.

     Начало — не ноль: подрезано по 25% с каждой стороны, то есть видно
     середину кадра. Из нуля это читалось бы появлением картинки, а нужно
     раскрытие уже стоящей на месте.

     Прогресс считает сам браузер по view()-таймлайну, а не rAF-подписка на
     скролл: ход не отстаёт от прокрутки ни на кадр, не занимает главный поток и
     не заводит второго слушателя рядом с Lenis. Диапазон назван кромками, а не
     числами, — их у него и нет: entry 0% — верх кадра на нижней кромке экрана,
     exit 0% — верх кадра на верхней.

     Клип лежит на всём боксе, а не на одной картинке: подпись — оверлей того же
     кадра и обязана уходить под ту же маску. Она стоит в той же ячейке сетки,
     поэтому подрезается вместе с кадром и проступает ровно там, где он открылся.
     Стики от клипа не страдает: он не заводит своего контейнера прокрутки. */
  .territory__media picture {
    display: block;
  }

  @keyframes territory-open {
    from {
      clip-path: inset(var(--reveal) var(--reveal) var(--reveal) var(--reveal));
    }
    to {
      clip-path: inset(0% 0% 0% 0%);
    }
  }

  /* Ход живёт только там, где таймлайн есть, а базовое состояние — открытый
     кадр. Без @supports браузер без view() проиграл бы ту же анимацию по
     обычному времени, то есть подрезал кадр и оставил его подрезанным насовсем.
     Длительность не задана намеренно: у прогрессного таймлайна она auto, а
     любое время в секундах ужало бы весь ход в долю диапазона.

     Скорость линейная: сглаживать нечего — ходом управляет прокрутка, и своя
     кривая поверх неё читается залипанием кадра.

     Порог по ширине — то же условие, что у остальной раскладки блока. Раскрытие
     остаётся на компьютере и снято только на узком экране: там кадр во всю
     колонку и невысокий, четверть подреза съедает его почти целиком, а
     подпись-оверлей на полпути стоит посреди обрезанного кадра. Диапазон при
     этом кончается на верхней кромке экрана, то есть на телефоне кадр доезжает
     до полного, уже уйдя за неё, — раскрытие видно не как раскрытие, а как
     недогруженная картинка. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 901px) {
      .territory__media {
        --reveal: 25%;
        animation-name: territory-open;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% exit 0%;
      }
    }
  }

  /* Подпись на кадре. Стики считает по своей ячейке сетки, то есть по самому
     кадру: пока его верхняя кромка ниже середины экрана, подпись стоит по этой
     кромке, дальше держится середины и отпускается на нижней кромке. Ровно то
     же поведение просили и от переходов сцены — ход рисует прокрутка.

     Центрируется сдвигом на половину себя, а не вычетом строки из 50svh: строк
     у правой части на узком экране больше одной, и вычет разъехался бы с её
     настоящей высотой. Сдвиг живёт в отрисовке и на диапазон стики не влияет.

     align-self: start обязателен — растянутая по ячейке подпись занимала бы её
     целиком и стики двигать было бы нечего.

     Цвет — выворотка `u-text-highlights` из утилит, тот же --fg-highlights, что
     сцена читает для белых форм кальки: подпись лежит на кадре, а не на бумаге,
     и текст темы на бледной панораме теряется. Своего цвета у компонента нет. */
  .territory__caption {
    position: sticky;
    top: 50svh;
    align-self: start;
    display: flex;
    justify-content: space-between;
    gap: var(--gutter);
    padding: var(--space-md);
    translate: 0 -50%;
  }

  .territory__sub {
    margin: 0 0 var(--space-lg);
  }

  /* Отбивка между абзацами крупнее шага текста, и это не вкус: набор идёт с
     вертикальным trim, то есть бокс абзаца обжат по кап-высоте, и 16 px между
     ними дают тот же просвет, что между строками внутри абзаца — два абзаца
     читаются одним.

     Выключка по формату — общая для всей страницы. Последняя строка остаётся по
     левому краю сама, это дефолт `justify`. */
  .territory__text {
    margin: 0 0 var(--space-2xl);
    text-align: justify;
  }

  .territory__text:last-child {
    margin-block-end: 0;
  }

  /* ── ключевые объекты ───────────────────────────────────────────────────── */
  /* Отбивка максимальная в шкале: выше стоит сцена в три экрана, и блок объектов
     после неё обязан читаться новым блоком, а не её продолжением. Своего числа
     здесь нет — это последний шаг шкалы. */
  .territory__objects {
    margin-block-start: var(--space-10xl);
  }

  .objects__title {
    margin: 0;
  }

  /* Три дорожки: кадр, поле, список. Список занимает ровно половину экрана —
     колонка страницы центрирована, поэтому её половина и есть середина экрана, и
     `50%` тут точнее любых долей. Междурядья между дорожками нет вовсе: гэп
     отодвинул бы границу списка от середины на свою половину. Отбивку от кадра
     держит средняя дорожка — она и есть поле.

     Кадр — пять колонок из двенадцати, та же доля, что у кадра закрывающего блока
     ниже: кадры обоих блоков обязаны стоять одной ширины, иначе на одной странице
     два разных размера без причины. Проценты в дорожках считаются от самой сетки,
     то есть от колонки страницы, — на кадре это выражение дало бы долю его
     половины.

     Строк ровно столько, сколько объектов, плюс одна свободная в хвосте — она и
     держит разницу высот. Без неё кадр, спанящий все строки, растолкал бы названия
     по своей высоте: при спане через гибкую дорожку избыток уходит в неё, а не в
     строки списка. Поэтому `--rows` приходит числом объектов из разметки, а не
     подобран. */
  .objects {
    display: grid;
    grid-template-columns: calc((100% - var(--gutter)) * 5 / 12) minmax(0, 1fr) 50%;
    grid-template-rows: repeat(var(--rows), min-content) 1fr;
    row-gap: var(--space-lg);
    column-gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Пункт списка боксом не является: пара «название — кадр» лежит рядом в
     разметке ради порядка чтения, а по колонкам её разводит сама сетка. */
  .obj {
    display: contents;
  }

  /* Название — кнопка, поэтому шрифт и цвет ей приходится назначить: браузер
     ставит кнопке свои. Растянута по колонке (грид-элемент по умолчанию), и
     наводится вся строка целиком, а не буквы. */
  .obj__pick {
    grid-column: 3;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    text-align: start;
    color: var(--muted-secondary);
    cursor: pointer;
    transition: color 0.4s var(--ease-expo);
  }

  .obj.is-active .obj__pick {
    color: var(--fg);
  }

  /* Все кадры лежат в одной ячейке друг на друге, показан один. Стопка стоит по
     верхней кромке списка и спанит его целиком — `align-self: start` обязателен,
     иначе кадр растянулся бы на всю высоту спана. */
  .obj__view {
    grid-column: 1;
    grid-row: 1 / -1;
    align-self: start;
    margin: 0;
    opacity: 0;
    transition: opacity 0.4s var(--ease-expo);
  }

  .obj.is-active .obj__view {
    opacity: 1;
  }

  /* Пропорцию держит бокс, а не файл: кадры приходят своей и ложатся в неё
     обрезкой. На боксе, а не на картинке, — она внутри выше него на запас
     параллакса, и пропорция на ней потащила бы за собой высоту всей ячейки. */
  .obj__box {
    aspect-ratio: 3 / 2;
  }

  /* Мера строки — сама колонка: описание принадлежит кадру и обязано стоять по
     его ширине. Своего ограничения у него поэтому нет — текст здесь в две-три
     строки, и колонка держит их без чужого правила. */
  .obj__text {
    margin: var(--space-lg) 0 0;
  }

  /* ── закрывающая мысль ──────────────────────────────────────────────────── */
  /* Отбивка от объектов максимальная в шкале, и она же единственная граница:
     линии у блока нет ни сверху, ни внутри — дисплейный заголовок начинает его
     сам.

     Слева набор, справа кадр. Колонки не равны намеренно: слева дисплейный
     заголовок и текст, справа портретный кадр — на равных долях заголовок
     ломался бы на вдвое большее число строк. */
  .territory__closing {
    margin-block-start: var(--space-10xl);
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--gutter);
  }

  /* Заголовок по верхней кромке, текст — по нижней. Высоту ряда задаёт кадр (его
     пропорция), и низ обеих колонок обязан сойтись: заголовок с текстом вплотную
     читался бы одним куском, а не разнесённой композицией. */
  .closing__body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6xl);
  }

  .closing__title {
    margin: 0;
  }

  /* Мера строки, а не ширина колонки: в 7/12 страницы абзац даёт под сотню знаков
     в строке и перестаёт читаться. Ограничение стоит на самих абзацах, а не на их
     обёртке: `ch` считается по кеглю элемента, а обёртка набрана крупнее — на ней
     те же 72ch дали бы меру шире колонки, то есть не дали бы ничего. */
  .closing__text .territory__text {
    max-inline-size: 72ch;
  }

  .closing__media {
    margin: 0;
  }

  /* Пропорция портретная и стоит на самой ячейке кадра, а не на боксе внутри:
     ячейка — элемент сетки, и это её высота задаёт высоту ряда. На боксе
     пропорция дала бы ту же картинку, но ряд считался бы по левой колонке, и
     низ двух колонок разъехался бы на её длину.

     Если набор слева окажется выше, ячейка растянется вместе с рядом (стандартный
     stretch), а бокс идёт за ней по высоте — поэтому 100%, а не пропорция. */
  .closing__media {
    aspect-ratio: 2 / 3;
  }

  .closing__box {
    block-size: 100%;
  }

  /* Ширина колонки страницы одна, а раскладка внутри блока — нет: на 900
     закрывающая мысль встаёт в один столбец, лента объектов — тоже. Порог тот же,
     на котором первый экран отпускает пин. */
  @media (max-width: 900px) {
    /* В один столбец: набор, под ним кадр. Портретная пропорция там не годится
       — во всю ширину экрана кадр занял бы полтора экрана высоты. */
    .territory__closing {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-6xl);
    }

    .closing__media {
      aspect-ratio: 4 / 3;
    }

    /* Двух колонок нет, и наведения тоже: на узком экране объект собирается
       обратно в карточку — название, кадр, описание, — и показаны все сразу.
       Порядок при этом ниоткуда не берётся: он ровно тот, что в разметке, —
       ради этого пара и лежит там рядом. */
    .objects {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      gap: var(--space-6xl);
    }

    .obj {
      display: block;
    }

    .obj__pick,
    .obj__view {
      grid-column: auto;
      grid-row: auto;
    }

    .obj__pick {
      color: var(--fg);
      cursor: default;
    }

    .obj__view {
      opacity: 1;
      margin-block-start: var(--space-lg);
    }

    /* Три подписи в строку на узком экране слипаются: центральная теряет
       середину, правая жмётся к краю. Ложатся стопкой и все по центру — под
       центрированным дисплейным заголовком они и есть его подписи, и по левому
       краю читались бы отдельным списком, сбитым с оси блока. Выключку из утилит
       перебивает правило компонента: оно вне слоёв. */
    .territory__notes {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-md);
    }

    .territory__note {
      text-align: center;
    }
  }

  /* Панорама этот порог больше не слушает: бокс 16:9 читается на любой ширине, и
     арт-дирекшна у него нет. Блок объектов — тоже: он уже в один столбец. */
  @media (max-width: 560px) {
    /* Две части подписи по краям кадра на телефоне дают две колонки по два
       слова: правая переносится вчетверо. Ложатся стопкой по левому краю. */
    .territory__caption {
      flex-direction: column;
      gap: var(--space-2xs);
    }
  }
</style>

<script>
  /**
   * Ключевые объекты: показанный кадр меняется по наведению на название.
   *
   * Состояние — класс на пункте, и переносится он с пункта на пункт: наведённый
   * кадр остаётся показанным, когда курсор ушёл с названия. Чисто на CSS
   * (`:has(:hover)`) это не выражается: без наведения пришлось бы возвращать
   * первый объект, и увод курсора в сторону кадра сбрасывал бы показанный.
   *
   * Первый пункт помечен активным на сервере, поэтому без JS блок остаётся
   * рабочим: виден первый объект, а на узком экране — все сразу.
   *
   * Фокус ведёт кадр наравне с курсором: названия — кнопки, и с клавиатуры блок
   * обязан работать так же. Второго слушателя скролла здесь нет вовсе — событие
   * приходит от самой кнопки.
   */
  const list = document.querySelector<HTMLElement>('[data-objects]');
  const items = list ? [...list.querySelectorAll<HTMLElement>('.obj')] : [];

  items.forEach((item, i) => {
    const show = () => items.forEach((el, n) => el.classList.toggle('is-active', n === i));
    const pick = item.querySelector<HTMLElement>('.obj__pick');
    pick?.addEventListener('pointerenter', show);
    pick?.addEventListener('focus', show);
  });
</script>
