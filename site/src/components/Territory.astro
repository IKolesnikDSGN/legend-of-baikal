---
/**
 * «О территории» — первый контентный блок после сцены.
 *
 * Состав пришёл из ТЗ и равен ему целиком: заголовок «Что такое Порт Байкал?»,
 * один абзац под дивайдером и панорама. Сцена в три экрана с двумя подблоками
 * текста, лента ключевых объектов и закрывающая мысль отсюда сняты вместе с их
 * текстами: они были написаны на время вёрстки, а в ТЗ у блока один абзац, и
 * фактология территории по-прежнему приходит от заказчика.
 *
 * Тема light стоит на самой секции. Секция и есть выход из сцены: последний экран
 * пина она поднимается снизу обычным скроллом, а открывает её сама сцена — фронт
 * финального наплыва снимает канвас в прозрачность. Пин отпускает ровно там, где
 * секция встала по верхней кромке, поэтому шва между кадром и страницей нет.
 * Механика перекрытия — в стилях ниже и в `hero/scroll.ts`.
 *
 * Идиома блока общая для страницы: заголовок по центру, дивайдер во всю колонку,
 * под ним текст — тот же ход, что у `h1` с подписями на первом экране.
 *
 * В боксе под текстом стоит съёмка территории с дрона — то самое место, под
 * которое бокс и держали 16:9. Заглушки (кроп кей-вижуала и фотография) отсюда
 * ушли вместе с чтением манифеста: выбирать больше не из чего, кадр настоящий.
 * Веб-версии пишет `scripts/video.mjs` из исходника с карты дрона — руками в
 * `public/media/` не кладётся ничего, как и во всём проекте.
 *
 * Под видео — сетка кадров с той же съёмки. Опись пишет стадия
 * `scripts/photos.mjs` из RAW, компонент не знает наизусть ни имён файлов, ни
 * пропорций: и ширины для `srcset`, и вертикальный кадр он берёт из неё.
 */
import photos from '../data/photos.json';

/**
 * Подписи кадров. Это единственное, чего стадия не считает: что на снимке —
 * содержание, а не геометрия, и выдумать его скрипт не может. Ключ — тот же id
 * кадра, что и в описи; кадр без подписи выйдет с пустым `alt`, то есть
 * декоративным, а не с враньём в самом доступном слое.
 */
const ALT: Record<string, string> = {
  '0017': 'Берег с посёлком под низкой облачностью, солнечная дорожка на воде',
  '0053': 'Суда и баржи у причала Порта Байкал, вид сверху',
  '0123': 'Лесистый склон над озером в утреннем тумане',
  '0156': 'Бухта порта с судами, туман над водой у дальнего берега',
  '0167': 'Деревянная церковь на склоне среди леса, полосы тумана',
  '0207': 'Мыс и посёлок у истока Ангары, туман над озером',
};

/** Самая большая ширина из описи — она же `src` для браузеров без `srcset`. */
const full = photos.widths[photos.widths.length - 1];
const src = (id: string, w: number) => `/media/photos/${id}-${w}.webp`;
---

<section class="territory u-spacer-top-lg u-spacer-btm-lg" id="territory" data-theme="light">
  <div class="u-container">
    <header class="territory__head">
      {/* Уровнем ниже дисплейного, и это не вкус: в названии есть «й», а у
          дисплейного стиля интерлиньяж 0.95 и вертикальный trim по кап-высоте —
          краткая не помещается. На широком экране заголовок стоит в одну строку
          и краткая просто выходит за бокс вверх, но на узком он ломается, и во
          второй строке она попадает в зону строки выше. У h1 интерлиньяж 1,
          и место ей остаётся. Текст заказчика, менять его нельзя. */}
      <h2 class="territory__title u-text-style-h1 u-alignment-center">Что такое Порт Байкал?</h2>
      <hr class="rule" />
      {/* Абзац стоит колонкой по центру блока: ось та же, что у заголовка и
          линии. Мера — в `ch` и на самом абзаце, а не на обёртке: `ch` считается
          по кеглю элемента. */}
      <p class="territory__text u-text-style-text-md">
        Порт Байкал расположился на западном берегу озера, у истоков реки Ангары.
        Через посёлок проходит Кругобайкальская железная дорога, а на территории
        расположились маяк, деревянная церковь и завод по добыче воды Legend of
        Baikal. У Порта Байкал есть всё, кроме архитектуры: живописный рельеф,
        история и постоянный поток туристов.
      </p>
    </header>

    {/* Съёмка территории. Форма держится в CSS, а не атрибутами width/height:
        бокс обязан стоять 16:9 и до загрузки, и после — кадр приходит ровно в
        этой пропорции, поэтому обрезки у него нет вовсе.

        Порядок источников решает, кому что достанется: VP9 берут Chrome и
        Firefox и он легче на треть, H.264 остаётся всем остальным. Ширина одна
        (1600) — у `<video>` нет `srcset`, а `media` у `<source>` браузеры не
        читают; почему именно она, записано в `scripts/video.mjs`.

        `autoplay` в разметке нет намеренно: воспроизведение включает наблюдатель
        ниже, когда бокс появляется на экране. Иначе браузер тянет мегабайты ещё
        на первом экране, до которого дело может и не дойти. Без скрипта и при
        `prefers-reduced-motion` в боксе остаётся постер — тот же первый кадр. */}
    <figure class="territory__media">
      <video
        class="territory__video"
        poster="/media/territory-poster.webp"
        preload="none"
        muted
        loop
        playsinline
        aria-label="Съёмка с воздуха: посёлок Порт Байкал вдоль берега озера, железнодорожная насыпь и лесистые сопки"
        data-territory-video
      >
        <source src="/media/territory-1600.webm" type="video/webm" />
        <source src="/media/territory-1600.mp4" type="video/mp4" />
      </video>
      {/* Подпись лежит оверлеем на кадре и разнесена по его краям: слева — что
          это, справа — чем снято. Стики держит её по центру экрана, пока кадр
          идёт мимо, и отпускает на его нижней кромке. */}
      <figcaption class="territory__caption u-text-style-text-sm u-weight-semibold u-text-highlights">
        <span>Панорама берега</span>
        <span>Съёмка с дрона</span>
      </figcaption>
    </figure>

    {/* Сетка кадров с той же съёмки — продолжение панорамы, а не отдельный
        блок: своего заголовка у неё нет, и от видео её отделяет тот же
        межколонник, что стоит между самими кадрами.

        Порядок — порядок съёмки: опись отдаёт кадры отсортированными по имени
        файла, и второй нумерации здесь не заводится. Вертикальный кадр
        помечается по измеренной пропорции (`h > w`), а не списком id: пришлют
        новую съёмку — разметка не изменится.

        Пропорция каждого кадра уезжает в разметку переменной: на узком экране
        кадр стоит в своей форме, и обрезки у него нет вовсе. Число — не цвет и
        не отступ, это геометрия самого файла, и в CSS ему места нет. */}
    <ul class="territory__grid">
      {photos.items.map((shot) => (
        <li
          class="photo territory__shot"
          style={`--ar: ${shot.w} / ${shot.h}`}
          data-tall={shot.h > shot.w ? '' : undefined}
        >
          <img
            src={src(shot.id, full)}
            srcset={photos.widths.map((w) => `${src(shot.id, w)} ${w}w`).join(', ')}
            sizes="(min-width: 901px) 50vw, 100vw"
            width={shot.w}
            height={shot.h}
            alt={ALT[shot.id] ?? ''}
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* ── выход из сцены ─────────────────────────────────────────────────────── */
  /* Секция поднята на высоту сцены и весь её финальный экран едет снизу вверх
     обычным скроллом — своей анимации у этого движения нет вовсе, это и есть
     прокрутка. Открывает секцию сама сцена: фронт последнего наплыва снимает
     канвас в прозрачность, и в дыру видно то, что здесь уже приехало. Пин
     отпускает ровно там, где секция встала по верхней кромке, поэтому шва и
     скачка между сценой и страницей нет.

     Атрибут ставит сцена (`hero/scroll.ts`) и только в режиме WebGL: без канваса
     открывать нечего, и наезд превратился бы в подмену кадра без перехода.
     Высота — та же `--hero-h`, которой живёт первый экран: второе число здесь
     разъехалось бы с длиной финального слота, и пин отпускал бы секцию не там,
     где она доехала.

     z-index: 0 обязателен вместе с position: relative — секция стоит в разметке
     после сцены, и позиционированная без своего слоя она легла бы поверх
     канваса, накрыв кадр вместо того, чтобы открыться из-под него. */
  :global(:root[data-hero-overlap]) .territory {
    position: relative;
    z-index: 0;
    margin-block-start: calc(var(--hero-h) * -1);
  }

  /* Фон секции над её собственной кромкой. Фронт наплыва рваный, с разбросом по
     высоте в 0.85 экрана, и его острова уходят выше того места, куда секция уже
     доехала: без этого поля в них просвечивал бы фон страницы с рампы KV, то
     есть тёмное пятно поверх открывшейся светлой секции. */
  :global(:root[data-hero-overlap]) .territory::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 100%;
    block-size: var(--hero-h);
    background: var(--bg);
  }

  /* Отступы поштучно каждому элементу, а не сбросом `.territory p`: сброс на
     теге специфичнее классов и молча съедает их собственные margin, а весь текст
     набран с вертикальным trim и без отступа встаёт кап-высотами вплотную. */
  /* Блок начинается заголовком: надзаголовков над h2 на странице нет ни в одной
     секции — заказчик их снял. Отступ сверху даёт спейсер секции. */
  .territory__title {
    margin: 0;
  }

  /* Колонка текста по центру блока. Мера стоит на самом абзаце: `ch` считается
     по кеглю элемента, и на обёртке, набранной крупнее, то же число дало бы
     другую ширину.

     Выключка по формату — общая для всей страницы, и она же условие центровки:
     при рваном правом крае масса текста стоит левее центра бокса, и абзац
     читается сдвинутым, хотя бокс стоит ровно по центру. Последняя строка
     остаётся по левому краю сама, это дефолт `justify`. */
  .territory__text {
    max-inline-size: 72ch;
    margin: 0 auto;
    text-align: justify;
  }

  /* Кадр и подпись лежат в одной ячейке сетки: подпись обязана быть оверлеем и
     при этом остаться в потоке — стики абсолютным элементам недоступен. Высоту
     ячейки задаёт кадр, подпись в неё только вписывается. */
  .territory__media {
    display: grid;
    margin: var(--space-6xl) 0 0;
  }

  .territory__media > * {
    grid-area: 1 / 1;
  }

  /* Бокс 16:9 — формат самой съёмки, и держать его в CSS по-прежнему нужно:
     пропорция обязана стоять до загрузки, иначе первый кадр двигал бы весь текст
     ниже. Число здесь, а не из манифеста: манифест описывает кропы пайплайна, а
     это контент заказчика.

     `object-fit: cover` тут страховка, а не кадрирование: исходник ровно 16:9,
     и обрезать у него нечего.

     Параллакса за прокруткой у видео нет, и это не пропуск: класс `.photo`
     двигает картинку внутри бокса, а у съёмки с дрона своё движение — камера и
     так идёт над берегом, и второй ход поверх читался бы дрожанием кадра. По той
     же причине его нет у коллажа сцены. */
  .territory__video {
    display: block;
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    /* Пока постер не пришёл, в боксе стоит фон темы, а не системный чёрный
       прямоугольник: секция светлая, и чёрная плашка в ней читается сбоем. */
    background: var(--bg);
  }

  /* ── сетка кадров ───────────────────────────────────────────────────────── */
  /* Кадры той же съёмки под видео. Отбивка от него — межколонник самой сетки, а
     не шаг секции: панорама и кадры читаются одним блоком, а не двумя, и второе
     число для одного зазора здесь не нужно.

     Базовая раскладка — одна колонка, и каждый кадр стоит в своей пропорции:
     обрезки нет вовсе. Она же остаётся на узком экране, где двум колонкам
     места нет. */
  .territory__grid {
    display: grid;
    gap: var(--gutter);
    margin: var(--gutter) 0 0;
    padding: 0;
    list-style: none;
  }

  .territory__shot {
    aspect-ratio: var(--ar);
  }

  /* Две колонки, и в них у кадров появляется общий шаг: все горизонтальные
     встают в одну форму, вертикальный занимает две строки.

     Форма общая, а не своя у каждого, и это условие раскладки: два соседа в
     строке с разной пропорцией дают под низким из них дыру — высоту строки
     держит высокий, а ужаться до чужой формы кадр не может. 3:2 — форма
     четырёх кадров из шести (6144×4096), остальным двум она стоит 11% высоты.

     Вертикальный кадр ростом ровно в две строки, и сетка от этого складывается
     без дыр: четыре горизонтальных по ячейке, два вертикальных по две — восемь
     ячеек на две колонки и четыре строки, ровный прямоугольник. Своей
     пропорции у него при этом нет вовсе: высоту задают соседние строки, и кадр
     садится в неё по `cover`.

     Порог — тот же, на котором в одну колонку ложится вся остальная страница. */
  @media (min-width: 901px) {
    .territory__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .territory__shot {
      aspect-ratio: 3 / 2;
    }

    .territory__shot[data-tall] {
      grid-row: span 2;
      /* Высоту дают две строки с межколонником между ними, и своя пропорция её
         бы переспорила: у элемента с заданным `aspect-ratio` растяжка по
         ячейке не работает вовсе. */
      aspect-ratio: auto;
    }
  }

  /* ── раскрытие панорамы прокруткой ──────────────────────────────────────── */
  /* Кадр открывается из своего центра в обе стороны и доходит до полного ровно
     к тому моменту, когда его верхняя кромка встаёт под верхнюю кромку экрана.
     Дальше он просто стоит открытым.

     Начало — не ноль: подрезано по 25% с каждой стороны, то есть видно
     середину кадра. Из нуля это читалось бы появлением картинки, а нужно
     раскрытие уже стоящей на месте.

     Прогресс считает сам браузер по view()-таймлайну, а не rAF-подписка на
     скролл: ход не отстаёт от прокрутки ни на кадр, не занимает главный поток и
     не заводит второго слушателя рядом с Lenis. Диапазон назван кромками, а не
     числами, — их у него и нет: entry 0% — верх кадра на нижней кромке экрана,
     exit 0% — верх кадра на верхней.

     Клип лежит на всём боксе, а не на одной картинке: подпись — оверлей того же
     кадра и обязана уходить под ту же маску. Она стоит в той же ячейке сетки,
     поэтому подрезается вместе с кадром и проступает ровно там, где он открылся.
     Стики от клипа не страдает: он не заводит своего контейнера прокрутки. */

  @keyframes territory-open {
    from {
      clip-path: inset(var(--reveal) var(--reveal) var(--reveal) var(--reveal));
    }
    to {
      clip-path: inset(0% 0% 0% 0%);
    }
  }

  /* Ход живёт только там, где таймлайн есть, а базовое состояние — открытый
     кадр. Без @supports браузер без view() проиграл бы ту же анимацию по
     обычному времени, то есть подрезал кадр и оставил его подрезанным насовсем.
     Длительность не задана намеренно: у прогрессного таймлайна она auto, а
     любое время в секундах ужало бы весь ход в долю диапазона.

     Скорость линейная: сглаживать нечего — ходом управляет прокрутка, и своя
     кривая поверх неё читается залипанием кадра.

     Порог по ширине — то же условие, что у остальной раскладки блока. Раскрытие
     остаётся на компьютере и снято только на узком экране: там кадр во всю
     колонку и невысокий, четверть подреза съедает его почти целиком, а
     подпись-оверлей на полпути стоит посреди обрезанного кадра. Диапазон при
     этом кончается на верхней кромке экрана, то есть на телефоне кадр доезжает
     до полного, уже уйдя за неё, — раскрытие видно не как раскрытие, а как
     недогруженная картинка. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 901px) {
      .territory__media {
        --reveal: 25%;
        animation-name: territory-open;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% exit 0%;
      }
    }
  }

  /* Подпись на кадре. Стики считает по своей ячейке сетки, то есть по самому
     кадру: пока его верхняя кромка ниже середины экрана, подпись стоит по этой
     кромке, дальше держится середины и отпускается на нижней кромке.

     Центрируется сдвигом на половину себя, а не вычетом строки из 50svh: строк
     у правой части на узком экране больше одной, и вычет разъехался бы с её
     настоящей высотой. Сдвиг живёт в отрисовке и на диапазон стики не влияет.

     align-self: start обязателен — растянутая по ячейке подпись занимала бы её
     целиком и стики двигать было бы нечего.

     Цвет — выворотка `u-text-highlights` из утилит, тот же --fg-highlights, что
     сцена читает для белых форм кальки: подпись лежит на кадре, а не на бумаге,
     и текст темы на бледной панораме теряется. Своего цвета у компонента нет.

     Тень под выворотку появилась вместе со съёмкой: у кадра кей-вижуала фон был
     тёмно-синий и белая строка на нём читалась сама, а на видео под подписью
     проходят и вода, и светлый берег, и небо — на них она пропадала. Цвет тени
     берётся от `--fg` темы через `color-mix`, а не пишется числом: своего цвета
     у компонента по-прежнему нет, а доля прозрачности — не цвет, а сила тени. */
  .territory__caption {
    position: sticky;
    top: 50svh;
    align-self: start;
    display: flex;
    justify-content: space-between;
    gap: var(--gutter);
    padding: var(--space-md);
    translate: 0 -50%;
    text-shadow: 0 1px 3px color-mix(in srgb, var(--fg) 72%, transparent);
  }

  /* Панорама порог раскладки не слушает: бокс 16:9 читается на любой ширине, и
     арт-дирекшна у него нет. */
  @media (max-width: 560px) {
    /* Две части подписи по краям кадра на телефоне дают две колонки по два
       слова: правая переносится вчетверо. Ложатся стопкой по левому краю. */
    .territory__caption {
      flex-direction: column;
      gap: var(--space-2xs);
    }
  }
</style>

<script>
  /**
   * Видео играет, пока оно на экране, и только если движение разрешено.
   *
   * `autoplay` в разметке не стоит: с ним браузер тянет мегабайты сразу на
   * первом экране, до которого дело может и не дойти, — блок лежит за сценой в
   * девять экранов пина. Наблюдатель здесь по той же причине, что и у
   * фиксированного хедера: своего слушателя скролла рядом с Lenis быть не
   * должно.
   *
   * `prefers-reduced-motion` проверяется живым запросом, а не один раз при
   * загрузке: настройку меняют, не перезагружая страницу. Выключенное движение
   * оставляет в боксе постер — тот же первый кадр, что и в самом файле.
   */
  const video = document.querySelector<HTMLVideoElement>('[data-territory-video]');
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  if (video) {
    const sync = (visible: boolean) => {
      // play() отдаёт промис и отклоняет его, если автовоспроизведение запрещено
      // политикой браузера. Это не ошибка страницы: в боксе просто остаётся постер.
      if (visible && !still.matches) void video.play().catch(() => {});
      else video.pause();
    };

    const io = new IntersectionObserver(([entry]) => sync(entry.isIntersecting));
    io.observe(video);

    still.addEventListener('change', () => {
      const box = video.getBoundingClientRect();
      sync(box.bottom > 0 && box.top < window.innerHeight);
    });
  }
</script>
