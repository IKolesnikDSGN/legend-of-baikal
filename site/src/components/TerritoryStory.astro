---
import { readFileSync } from 'node:fs';

import { PHOTOS, STORY_PHOTOS, photo } from '../lib/photos';

/**
 * Сцена внутри «О территории»: два подблока текста, разведённые прокруткой.
 *
 * Стоит на месте, где раньше лежали две текстовые колонки. Содержание то же —
 * как здесь появился порт и что от него осталось, — но читаются они не рядом, а
 * по очереди. Сцена длиной в три экрана: композиция залипает по центру и весь
 * пин едет чуть вверх, а на его середине один подблок сменяется другим.
 *
 * Смена — не скролл-скраб, и это главное её свойство. Прокрутка только даёт
 * команду: середина сцены прошла середину экрана — дальше ход идёт своим
 * временем, 1.2 с на expo.out, и уход первого подблока с приходом второго
 * стартуют в один кадр. Кадры вокруг меняются тем же движением: уходящие гаснут
 * очередью, приходящие раскрываются клипом из своего центра.
 *
 * Ход обратим: состояние — это одна фаза (`data-phase`), и она выводится из
 * положения прокрутки, а не накапливается. Отмотка вверх возвращает первый
 * подблок тем же движением, каким он ушёл, в том числе на полпути — переход
 * ведут transition, и они разворачиваются из любой точки.
 *
 * Строка здесь — не абзац и не элемент разметки, а то, что реально сложил
 * переносами браузер: разбивку делает `hero/lines.ts` измерением.
 */

/** Кадры вокруг текста — заглушки. Фотографий территории в проекте нет ни одной,
    и придумать их нельзя: здесь стоят готовые рендеры легенд из пайплайна. Взяты
    они не для красоты — они разные, и только на разных картинках видно и
    затухание очередью, и раскрытие клипом; один кадр в шести плашках прочитался
    бы техническим швом, а не сменой кадров. Придёт съёмка территории — меняются
    id и путь, геометрия коллажа остаётся на месте.

    Из манифеста приходят ширины: это набор реально собранных файлов, и второго
    места, где он записан, быть не должно. Формат один, webp: avif пайплайн
    собирает только для кропов первого экрана. */
const manifest = JSON.parse(
  readFileSync(new URL('../../public/kv/manifest.json', import.meta.url), 'utf8'),
) as { legendWidths: number[] };

const shotWidths = [...manifest.legendWidths].sort((a, b) => a - b);
const srcset = (id: string) => shotWidths.map((w) => `/kv/legends/${id}-${w}.webp ${w}w`).join(', ');
const base = (id: string) => `/kv/legends/${id}-${shotWidths[0]}.webp`;

/** Геометрия коллажа: доля стенда по горизонтали и вертикали, ширина и пропорция
    плашки, точка кропа внутри неё. Числа здесь art-direction, а не шаг шкалы, —
    то же исключение, что у слота логотипа: это размер и место элемента, которых
    в шкале нет и быть не может. Все в долях стенда, поэтому коллаж едет вместе с
    экраном, а не рассыпается на узком.

    Расставлены по краям: середину занимает набор — заголовок и текст под ним, —
    и плашки обязаны его обходить. Перекрытие кеглем допустимо, так же лежит
    коллаж в макете-референсе, а вот текст поверх картинки не читается. */
/** Вторая геометрия — узкий экран (≤900). Она обязана быть своей, а не долей
    первой: на широком кадры стоят по краям и обходят набор слева и справа, а на
    узком набор идёт во всю колонку, и места сбоку не остаётся вовсе — там кадры
    и превращались в полоски в палец, из-за чего их когда-то сняли совсем.
    Свободна на узком только верхняя полоса стенда: замер даёт заголовок на
    29–41% высоты (375×667 … 900×700), а низ занят текстом почти до кромки —
    на 375×667 набор доходит до 91.6%. Поэтому все три кадра слайда собираются
    в кластер над заголовком.

    Размер там задаётся ВЫСОТОЙ, а не шириной, и это условие, а не вкус: доля
    ширины на широком-коротком экране (900×700) дала бы кадру 3/4 высоту в
    полтора стенда, то есть поверх всего набора. Высота в долях стенда держит
    кластер в своей полосе на любой паре сторон, а ширину доводит пропорция. */
type Shot = {
  slide: 0 | 1;
  id: string;
  /** доли стенда: отступ слева и сверху */
  x: number;
  y: number;
  /** ширина плашки в долях стенда и её пропорция */
  w: number;
  ar: string;
  /** точка кропа: рендер приходит горизонтальным, портретной плашке нужен центр */
  pos: string;
  /** узкий экран: отступ слева и сверху в долях стенда */
  mx: number;
  my: number;
  /** узкий экран: ВЫСОТА плашки в долях стенда — ширину доводит пропорция */
  mh: number;
};

const shots: Shot[] = [
  { slide: 0, id: 'lighthouse', x: 2, y: 9, w: 21, ar: '3 / 4', pos: '55% 45%', mx: -3, my: 2, mh: 25 },
  { slide: 0, id: 'railway', x: 76, y: 14, w: 22, ar: '4 / 3', pos: '50% 50%', mx: 58, my: 4, mh: 18 },
  { slide: 0, id: 'factory', x: 12, y: 63, w: 17, ar: '1 / 1', pos: '45% 55%', mx: 30, my: 13, mh: 13 },
  { slide: 1, id: 'epishura', x: 4, y: 26, w: 20, ar: '4 / 3', pos: '50% 50%', mx: -4, my: 5, mh: 17 },
  { slide: 1, id: 'bell', x: 75, y: 8, w: 16, ar: '4 / 5', pos: '50% 40%', mx: 60, my: 2, mh: 25 },
  { slide: 1, id: 'ice-road', x: 76, y: 56, w: 17, ar: '3 / 4', pos: '55% 50%', mx: 24, my: 13, mh: 12 },
];

/** Тексты — те же, что стояли в двух колонках блока. Заголовок меняется вместе
    со своим текстом: подблок уходит и приходит целиком, одной очередью строк. */
const slides = [
  {
    title: 'Как здесь появился порт',
    paras: [
      'Порт Байкал построили как стык двух дорог — железной и водной. Поезда доходили до берега, состав загоняли на паром-ледокол и переправляли на другую сторону озера; посёлок жил этим ритмом, а не сам по себе.',
      'Потом Кругобайкальскую дорогу обошли новой трассой, и стык перестал быть нужен: линия стала тупиковой веткой, а порт — концом пути вместо его середины.',
    ],
  },
  {
    title: 'Что от него осталось',
    paras: [
      'Тупик оказался консервацией. Деревянные дома, депо, причальная стенка и сама дорога с тоннелями и виадуками стоят почти в том виде, в котором их оставили, — место читается целиком.',
      'Люди на берег приходят до сих пор: паром из Листвянки, поезд по Кругобайкальской, зимой — лёд. Приходят и уезжают в тот же день: остаться здесь пока негде и незачем.',
    ],
  },
];
---

<div class="story" data-story>
  {/* Метка второй половины сцены: по ней срабатывает смена подблоков. Своей
      высоты у неё нет — она ровно половина сцены, от середины до нижней кромки,
      и наблюдателю нужна именно длина: 1px-метку быстрый скролл проскочил бы
      между кадрами, и команда не пришла бы вовсе. */}
  <div class="story__mid" aria-hidden="true" data-story-mid></div>

  <div class="story__stage">
    {/* Кадры лежат под текстом: заголовок и абзацы обязаны читаться поверх них. */}
    <div class="story__shots" aria-hidden="true">
      {shots.map((s, i) => (
        <div
          class="shot"
          data-slide={s.slide}
          style={`--x:${s.x}%;--y:${s.y}%;--w:${s.w}%;--mx:${s.mx}%;--my:${s.my}%;--mh:${s.mh}%;--ar:${s.ar};--pos:${s.pos};--n:${i % 3}`}
        >
          {/* alt пустой намеренно: это заглушка, а не фотография места. Описать
              её как берег значило бы соврать в самом доступном слое. */}
          {/* Параллакса у плашек коллажа нет намеренно, в отличие от остальных
              кадров страницы: стенд залипает по центру экрана, и `view()` на
              залипшем элементе почти не двигается — ход стоял бы на месте. Своё
              движение у них уже есть: затухание очередью и раскрытие клипом. */}
          <img
            class="shot__img"
            src={PHOTOS ? photo(STORY_PHOTOS[s.id]) : base(s.id)}
            srcset={PHOTOS ? undefined : srcset(s.id)}
            sizes={PHOTOS ? undefined : '25vw'}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>

    {/* Текст стоит в общей колонке страницы, кадры — во всю ширину стенда: у
        коллажа и у набора разные поля, и колонку здесь держит `u-container`. */}
    <div class="story__slides u-container">
      {slides.map((s, i) => (
        <article class="slide" data-slide={i} data-lines-group>
          <h3 class="slide__title u-text-style-display u-alignment-center" data-lines>
            {s.title}
          </h3>
          <div class="slide__text">
            {s.paras.map((p) => (
              <p class="slide__para u-text-style-text-lg">{p}</p>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</div>

<style>
  /* ── базовое состояние: два подблока в потоке ────────────────────────────── */
  /* Так блок выглядит там, где сцены нет вовсе: при prefers-reduced-motion и до
     разбивки текста на строки. Оба подблока лежат стопкой и читаются подряд — то
     же, что две колонки до этой правки, только в один столбец. Ни одного
     элемента сцены здесь не видно: коллаж — декорация стенда, и в потоке шесть
     плашек с абсолютным позиционированием сложились бы в кучу у верхней кромки. */
  .story__slides {
    display: grid;
    gap: var(--space-6xl);
  }

  .slide {
    display: grid;
    justify-items: center;
  }

  .slide__title {
    /* Мера заголовка: на дисплейном кегле строка во всю колонку не читается, а
       центрированная — тем более. 15ch на этом кегле — два-три слова в строку:
       оба заголовка ломаются на две строки, и очередь по строкам видна у обоих. */
    max-inline-size: 15ch;
  }

  /* Текст стоит прямо под заголовком и по его центру, а набран влево: блок по
     центру, выключка левая. Мера строки — как у остальных абзацев страницы. */
  .slide__text {
    max-inline-size: 44ch;
    margin-block-start: var(--space-2xl);
  }

  /* Отступы поштучно, а не сбросом `.slide p`: сброс на теге специфичнее классов
     и молча съел бы их собственные margin. */
  .slide__para {
    /* Отбивка между абзацами крупнее, чем в наборе на бумаге: строки уходят и
       приходят очередью, и на шаге в 16 px абзац читается продолжением
       предыдущего, а не своим блоком. */
    margin: 0 0 var(--space-lg);

    /* Выключка по формату — общая для всей страницы. Здесь она работает только
       до разбивки: дальше её берёт на себя `text-align-last` у самих строк (см.
       ниже), потому что после разбивки каждая строка — отдельный блок. */
    text-align: justify;
  }

  .slide__para:last-child {
    margin-block-end: 0;
  }

  .story__mid,
  .story__shots {
    display: none;
  }

  .shot {
    position: absolute;
    inset-block-start: var(--y);
    inset-inline-start: var(--x);
    inline-size: var(--w);
    aspect-ratio: var(--ar);
  }

  /* Пропорцию держит плашка, а не файл: рендер приходит горизонтальным, и в
     портретную плашку он ложится обрезкой по своей точке кропа. */
  .shot__img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: var(--pos);
  }

  /* ── сцена ──────────────────────────────────────────────────────────────── */
  /* Все числа сцены — в одном месте.

     Длина: три экрана, по одному на каждый подблок и один на смену между ними.
     Первый и последний — не пустой ход, композиция там стоит и читается.

     Смена идёт своим временем, а не долей прокрутки: прокрутка только даёт
     команду на середине пина. Поэтому здесь секунды, а не проценты. 0.9 с — это
     ход одной строки; весь подблок длиннее на хвост очереди, строк в нём около
     десяти, и последняя доезжает примерно к полутора секундам. Шаг у кадров
     крупнее: их три, и очередь из трёх на шаге строки не читается вовсе.

     Кривая — тот же токен, что ведёт вход карточки легенды и строки первого
     экрана. Второй такой же заводить незачем. */
  .story {
    --swap: 0.9s;
    --line-step: 0.04s;
    --shot-step: 0.09s;
    /* Приходящий подблок трогается позже уходящего — и это не отказ от
       одновременности, а её условие. Маски у подблоков свои и стоят почти на
       одной высоте: пущенные в один кадр, они дают полсекунды двойного текста,
       где в одной полосе читаются сразу две строки. Лаг мельче хода в пять раз,
       поэтому смена остаётся одним движением, а не двумя по очереди.

       Он же нужен и кадрам: уходящий и приходящий коллажи местами перекрываются,
       и на общем старте плашки просвечивают друг через друга. */
    --swap-lag: 0.2s;
    /* Ход строки — в долях её собственной высоты, а не в em и не в пикселях:
       строка обязана уйти под кромку своей маски целиком и на любом кегле. */
    --line-travel: 110%;
    /* Припуск маски: на 110% строка уходит за свою высоту, но маска выше строки
       на свои поля (см. ниже), и без этой добавки у дисплейного заголовка из-под
       кромки виден остаток в пиксель. */
    --line-slack: 0.2em;
    /* Смещение всей композиции вверх за сцену: она залипла по центру, но не
       стоит мёртво — знак того, что прокрутка идёт, пока текст меняется. */
    --drift: 25svh;
  }

  /* Сцена включается двумя условиями, и оба обязательны.
     prefers-reduced-motion: движение здесь и просили убрать — блок читается
     стопкой, как читался до правки.
     data-story-split: строки создаёт скрипт, и без него у второго подблока нет
     ни одного элемента, которому можно спрятаться, — два текста легли бы друг на
     друга. Тот же скрипт ставит и фазу, поэтому раскладка стенда и её механика
     включаются одним движением. Скролл-таймлайн в этот гард не входит: своим
     временем ход идёт и без него. */
  @media (prefers-reduced-motion: no-preference) {
    .story[data-story-split] {
      block-size: 300svh;
      /* Метка второй половины считает от сцены */
      position: relative;
    }

    .story[data-story-split] .story__mid {
      display: block;
      position: absolute;
      inset-inline: 0;
      inset-block: 50% 0;
    }

    /* Стенд залипает на весь свой участок: на 300svh сцены и 100svh стенда это
       ровно два экрана прокрутки, и второго числа для длины пина нет вовсе. */
    .story[data-story-split] .story__stage {
      position: sticky;
      inset-block-start: 0;
      block-size: 100svh;
      display: grid;
    }

    /* Кадры и текст — в одной ячейке стенда: это два слоя одной композиции. */
    .story[data-story-split] .story__stage > * {
      grid-area: 1 / 1;
    }

    .story[data-story-split] .story__shots {
      display: block;
      position: relative;
    }

    /* Оба подблока в одной ячейке: они стоят в одном месте стенда и сменяют друг
       друга, а не идут подряд. */
    .story[data-story-split] .story__slides {
      display: grid;
      gap: 0;
      padding-block: var(--section-sm);
    }

    /* Шов между заголовком и текстом стоит по середине стенда: заголовок растёт
       от него вверх, текст — вниз. Так композиция центрирована и, главное, стоит
       на месте при смене подблока. Центрировать каждый подблок целиком нельзя:
       строк у них разное число, и на смене вся композиция подпрыгивала бы. */
    .story[data-story-split] .slide {
      grid-area: 1 / 1;
      grid-template-rows: 1fr 1fr;
    }

    .story[data-story-split] .slide__title {
      align-self: end;
    }

    .story[data-story-split] .slide__text {
      align-self: start;
    }

    /* Строка — блок: переносы здесь посчитаны измерением, и ход идёт по ним.
       Тот же приём, что у входа первого экрана.

       :global обязателен у всех правил на строку, и это не вкусовщина. Строки
       создаёт скрипт, а Astro дописывает в свои селекторы атрибут-скоуп, который
       есть только у узлов из шаблона: без :global правило не совпадёт ни с одной
       строкой — молча, без ошибки в консоли. Скоуп при этом остаётся на предках,
       то есть за пределы сцены правило не выходит. */
    /* Маска строки. Она же и обрезает, и держит место в наборе: узлов на строку
       два именно поэтому — один элемент не может разом обрезать себя и уезжать
       из себя.

       Поля по вертикали с обратными полями — не отступ, а припуск маски. У
       дисплейного заголовка интерлиньяж 0.9, то есть строчный бокс мельче самих
       букв: без припуска маска срезала бы ноги «Д» и «Ц», а метрика набора при
       этом обязана остаться прежней — её возвращают отрицательные margin.
       Гаснуть строке не нужно вовсе: её убирает маска, а прозрачность поверх
       маски только смазывает кромку. */
    .story[data-story-split] :global(.line) {
      display: block;
      overflow: hidden;
      padding-block: 0.1em;
      margin-block: -0.1em;
    }

    /* Выключка по формату после разбивки. `text-align: justify` сюда не доходит
       вовсе: строка разложена в свой блок, и в нём она единственная, то есть
       последняя, — а последнюю строку `justify` не растягивает никогда. Поэтому
       строки выключаются `text-align-last`, и все, кроме последней в абзаце:
       у неё рваный правый край, как и положено концу абзаца.

       Переносы от этого не меняются: разбивка меряет их до выключки, а `justify`
       правит только пробелы внутри уже сложенной строки. */
    .story[data-story-split] .slide__para :global(.line:not(:last-child) .line__in) {
      text-align-last: justify;
    }

    .story[data-story-split] :global(.line__in) {
      display: block;
      /* Ход ведут transition, а не keyframes: команда приходит один раз, а
         развернуться она обязана из любой точки — отмотка на полпути должна
         вести строку назад с того места, где её застали, а не с начала. */
      transition: translate var(--swap) var(--ease-expo) calc(var(--i, 0) * var(--line-step));
    }

    /* Второй подблок ждёт под своей маской. Это его исходное состояние, а не
       кадр анимации; строки первого в этот момент стоят на месте и читаются. */
    .story[data-story-split] [data-slide='1'] :global(.line__in) {
      translate: 0 calc(var(--line-travel) + var(--line-slack));
    }

    /* Команда: первый подблок уходит под верхнюю кромку своих масок, второй
       приходит из-под нижних. */
    .story[data-story-split][data-phase='2'] [data-slide='0'] :global(.line__in) {
      translate: 0 calc((var(--line-travel) + var(--line-slack)) * -1);
    }

    .story[data-story-split][data-phase='2'] [data-slide='1'] :global(.line__in) {
      translate: 0 0;
    }

    /* Лаг висит на состоянии, а не на элементе, и это единственный способ
       сохранить ход симметричным. Позже трогается тот подблок, который приходит,
       — а приходит на отмотке вверх уже первый. Задержка, приписанная второму
       подблоку навсегда, дала бы на обратном ходу ту же кашу, от которой она и
       поставлена. */
    .story[data-story-split][data-phase='2'] [data-slide='1'] :global(.line__in),
    .story[data-story-split][data-phase='1'] [data-slide='0'] :global(.line__in) {
      transition-delay: calc(var(--swap-lag) + var(--i, 0) * var(--line-step));
    }

    /* Кадры идут тем же ходом и по той же команде. Уходящие гаснут, приходящие
       раскрываются клипом из своего центра во все стороны — та же природа, что у
       панорамы блока и у наплыва легенд: порог, а не растушёванный край. */
    .story[data-story-split] .shot {
      transition:
        opacity var(--swap) var(--ease-expo) calc(var(--n) * var(--shot-step)),
        clip-path var(--swap) var(--ease-expo) calc(var(--n) * var(--shot-step));
    }

    .story[data-story-split] .shot[data-slide='1'] {
      clip-path: inset(50%);
    }

    .story[data-story-split][data-phase='2'] .shot[data-slide='0'] {
      opacity: 0;
    }

    .story[data-story-split][data-phase='2'] .shot[data-slide='1'] {
      clip-path: inset(0%);
    }

    /* Тот же лаг и по той же причине, что у строк: приходящий коллаж трогается
       позже уходящего, и на обратном ходу они меняются ролями. */
    .story[data-story-split][data-phase='2'] .shot[data-slide='1'],
    .story[data-story-split][data-phase='1'] .shot[data-slide='0'] {
      transition-delay: calc(var(--swap-lag) + var(--n) * var(--shot-step));
    }

    /* Смещение композиции вверх — единственное, что здесь считает прокрутка, и
       считает его браузер сам: view()-таймлайн самой сцены, диапазон `contain`
       совпадает с залипанием стенда ровно (он начинается там, где сцена накрыла
       экран целиком, и кончается там, где её нижняя кромка дошла до низа).

       Гард обязателен: без таймлайна та же анимация проиграла бы по обычному
       времени — композиция уехала бы вверх сама, до того как до неё доскроллили,
       и осталась бы там. Длительность не задана намеренно: у прогрессного
       таймлайна она auto, а время в секундах ужало бы весь ход в долю диапазона.
       Скорость линейная — ходом управляет прокрутка. */
    @supports (animation-timeline: view()) {
      .story[data-story-split] {
        view-timeline-name: --story;
      }

      .story[data-story-split] .story__stage {
        animation: story-drift linear both;
        animation-timeline: --story;
        animation-range: contain 0% contain 100%;
      }
    }
  }

  @keyframes story-drift {
    from {
      translate: 0 var(--drift);
    }
    to {
      translate: 0 calc(var(--drift) * -1);
    }
  }

  /* Колонка страницы одна, а место композиции — нет: на узком экране набор идёт
     во всю колонку, и по краям от него не остаётся ничего. Кадры поэтому не
     уходят, а переезжают: все три собираются в кластер над заголовком, в
     единственную свободную полосу стенда (замер: заголовок начинается на 29–41%
     высоты, а низ занят текстом почти до кромки). Порог тот же, на котором блок
     складывает колонки, а первый экран отпускает пин. */
  @media (max-width: 900px) {
    .slide__text {
      max-inline-size: none;
    }

    /* Ход композиции за пин здесь короче, и это условие кластера, а не вкус. На
       широком экране кадры разнесены по всей высоте стенда, и полэкрана хода
       (±25svh) им не мешают: что уходит сверху, то приходит снизу. На узком все
       три стоят в одной полосе сверху, и на том же ходу они сметались за верхнюю
       кромку раньше, чем их успевали увидеть, — замер на 390×844: к середине
       пина кадры стояли на −120…124, то есть наполовину срезанные, а приходящий
       коллаж второго подблока не показывался вовсе. */
    .story {
      --drift: 8svh;
    }

    /* Размер — от высоты стенда, положение по горизонтали — от его ширины. Доля
       ширины здесь не годится вовсе: на 900×700 кадр 3/4 шириной в треть стенда
       был бы высотой в полтора стенда и накрыл бы весь набор. */
    .story[data-story-split] .shot {
      inset-inline-start: var(--mx);
      inset-block-start: var(--my);
      inline-size: auto;
      block-size: var(--mh);
    }

    /* Кластеру разрешено уходить за кромки стенда — кадры у края и задуманы
       подрезанными. Клип обязателен: ширину кадру доводит пропорция, в процентах
       она не известна, и без него плашка у правого края дала бы горизонтальную
       прокрутку всей страницы. Стоит на слое кадров, а не на стенде: набор лежит
       в соседнем слое и обрезаться не должен. */
    .story[data-story-split] .story__shots {
      overflow: clip;
    }
  }
</style>

<script>
  import { prepare, restore } from '../hero/lines';

  /**
   * Скрипт сцены делает ровно две вещи: разбивает текст на строки и держит фазу.
   * Сам ход — CSS: и время, и кривая, и очередь живут там.
   *
   * Условие здесь то же, что в CSS-гарде: при запрошенном покое сцены нет вовсе,
   * и строки в этом случае не нужны — блок читается стопкой. Разъехаться им
   * нельзя, атрибут этого скрипта включает раскладку стенда, а раскладка без
   * строк оставила бы второй подблок поверх первого.
   */
  const ok = matchMedia('(prefers-reduced-motion: no-preference)').matches;

  const story = document.querySelector<HTMLElement>('[data-story]');
  const mid = document.querySelector<HTMLElement>('[data-story-mid]');
  const slides = story ? [...story.querySelectorAll<HTMLElement>('.slide')] : [];

  if (ok && story && mid && slides.length) {
    /**
     * Команда на смену подблоков. Наблюдатель смотрит на вторую половину сцены
     * через корень, сжатый полями до линии по центру экрана: метка перекрывает
     * эту линию ровно на второй половине пина. Своего слушателя скролла у сцены
     * поэтому нет — рядом с Lenis он был бы вторым, и на каждый кадр.
     *
     * Фаза выводится из положения метки, а не переключается по событию: сцену
     * можно проскочить прыжком (якорь, restore позиции), и «ушла» приходит в обе
     * стороны одним и тем же событием — по какую сторону линии оказалась верхняя
     * кромка метки, видно только из её координат.
     *
     * Сравнение идёт именно с линией триггера, а не с верхом экрана. Иначе на
     * выходе из сцены вниз метка уходит выше линии, но ниже верхней кромки
     * экрана, и её положение читается как «ещё не дошли»: подблоки уезжали
     * обратно в первый прямо под уходящей сценой. Линию отдаёт сам наблюдатель,
     * поэтому её половина живёт один раз — в `rootMargin`.
     *
     * Подписка живёт в `layout`, а не рядом с этим объявлением, и это не порядок
     * ради порядка. У
     * метки нет бокса, пока стенд не поднят: `.story__mid` до этого
     * `display: none`. Наблюдатель отдаёт первый вызов сразу после `observe`, и
     * на скрытой метке он приходит с прямоугольником из одних нулей — а `0` от
     * линии по центру экрана всегда «выше», то есть фаза защёлкивалась в `2` на
     * самой загрузке, когда до сцены ещё десять экранов пина. Исправиться ей было
     * уже нечем: наблюдатель зовут на смену пересечения, а метка шла из «не
     * пересекает» в «не пересекает», и на входе в сцену тот же нуль давал ту же
     * двойку. Смены подблоков не было вовсе — сцена приезжала уже переключённой.
     *
     * Ловилось это гонкой со шрифтом, поэтому и выглядело как «работает только
     * после хард релоада»: раскладку ставит `document.fonts.ready`, и на
     * прогретом кэше она успевала до первого вызова наблюдателя, а на холодном —
     * нет. Замер на холодной загрузке: 200 мс, `scrollY` 0, высота метки 0,
     * фаза 2.
     *
     * Отсюда и гард ниже. Он не дублирует подписку: стенд можно потерять на
     * ресайзе в низкий экран, и снятая подписка гонится с уже назначенным
     * вызовом. Фаза выводится из положения метки — у метки без бокса положения
     * нет, и трогать фазу нельзя.
     */
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.boundingClientRect.height) return;
        const line = e.rootBounds ? e.rootBounds.top : innerHeight / 2;
        story.dataset.phase = e.boundingClientRect.top <= line ? '2' : '1';
      },
      { rootMargin: '-50% 0px -50% 0px' },
    );

    /**
     * Раскладка стенда и разбивка строк — одним движением, плюс проверка на то,
     * что сцена вообще влезает в экран.
     *
     * Атрибут ставится ДО разбивки, и порядок здесь не косметический: строки
     * считаются измерением, мерить их нужно в той раскладке, в которой они
     * встанут. В потоке подблок шире, чем на стенде, и переносы посчитались бы
     * по чужой ширине. Стили применятся синхронно — первое же измерение внутри
     * `prepare` заставит браузер пересчитать раскладку.
     *
     * Стенд залипает ростом ровно в экран (`100svh`), и подблок обязан влезать в
     * него целиком: обрезать лишнее нечем — сцена лежит в потоке страницы, и
     * перебор полез бы на соседние блоки. Не влезает — сцены нет вовсе: блок
     * читается стопкой, тем же состоянием, что при `prefers-reduced-motion`.
     *
     * Условие — замер, а не порог по высоте экрана: высота набора зависит и от
     * ширины, и от кегля, и одним числом это не выражается. Замер: на 320×568
     * перебор 89 px, на телефоне лёжа (844×390) — 3 px, а на 390×844 запас ещё
     * 97 px. Меряется каждый подблок сам по себе — `scrollHeight` против
     * `clientHeight`: у растянутого по стенду грида перебор строк и есть
     * разница между ними.
     *
     * Строки при отказе возвращаются в исходную разметку, и это обязательно:
     * они лежат отдельными спанами без пробелов между ними, и в обычном потоке
     * слиплись бы в одно слово на каждом переносе.
     */
    const layout = () => {
      story.dataset.storySplit = '';
      slides.forEach(prepare);

      if (slides.every((s) => s.scrollHeight <= s.clientHeight)) {
        // Стенд поднялся — только теперь у метки есть бокс, и только теперь по
        // ней можно считать фазу. Начальная фаза — первый подблок: пока метка не
        // сказала обратного, читается тот текст, который стоит в сцене первым.
        story.dataset.phase = '1';
        io.observe(mid);
        return;
      }

      delete story.dataset.storySplit;
      slides.forEach(restore);
      // Стенда нет — нет и метки: подписка на скрытый узел даёт ровно ту ошибку,
      // от которой стоит гард в самом наблюдателе.
      io.unobserve(mid);
    };

    // Шрифт решает, где переносы: посчитанные по системному фолбэку строки
    // разъедутся, как только доедет Manrope. Секция лежит ниже сцены первого
    // экрана — до неё не доскроллить раньше, чем шрифт загрузится.
    document.fonts.ready.then(layout);

    // Ширина меняет число строк, поэтому на ресайзе они пересобираются. На той
    // же ширине `prepare` не делает ничего, но замер идёт всё равно: высота
    // экрана меняется и без ширины — поворот телефона и адресная строка, — и
    // сцена обязана отдать стенд ровно тогда, когда перестала в него влезать.
    addEventListener('resize', layout);

  }
</script>
