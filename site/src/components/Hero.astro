---
/**
 * Первый экран.
 *
 * Разметка обязана быть читаемой без JS (ТЗ 2.8): статичный кадр картинкой,
 * заголовок, полный список легенд с текстами. Скрипт только надстраивает —
 * прячет статику, поднимает канвас и берёт скролл на себя.
 */
import { getCollection, render } from 'astro:content';

import SiteNav from './SiteNav.astro';
import { CTA, WORDMARK } from '../lib/nav';

const entries = (await getCollection('legends')).sort((a, b) => a.data.order - b.data.order);
const legends = await Promise.all(
  entries.map(async (e) => ({ id: e.id, data: e.data, Body: (await render(e)).Content })),
);

const teasers = Object.fromEntries(legends.map((l) => [l.id, l.data.teaser]));
---

{/* Без JS экрана входа нет: он держит сцену закрытой и снимается кликом,
    которого некому обработать. Текст первого экрана при этом остаётся видимым —
    прячет его атрибут, который ставит скрипт. */}
<noscript>
  <style is:inline>
    .hero__gate {
      display: none;
    }
  </style>
</noscript>

{/* Тема на секции: кадр живёт в тёмно-синем, и цвета текста, кнопки и меток
    берутся из её токенов — те же, что сцена читает для кальки. */}
<section class="hero" data-hero-section data-theme="brand">
  <div class="hero__stage" data-hero data-teasers={JSON.stringify(teasers)}>
    <canvas class="hero__canvas" aria-hidden="true"></canvas>

    {/* Статика: то, что видно без JS и до инициализации сцены */}
    <picture class="hero__static">
      <source srcset="/kv/kv-fullbleed-1920.avif 1920w, /kv/kv-fullbleed-2880.avif 2880w" type="image/avif" />
      <img
        src="/kv/kv-fullbleed-1920.webp"
        srcset="/kv/kv-fullbleed-1440.webp 1440w, /kv/kv-fullbleed-1920.webp 1920w, /kv/kv-fullbleed-2880.webp 2880w"
        sizes="100vw"
        alt="Панорама байкальского берега в тумане: посёлок, порт, церковь на холме и маяк на скале"
        width="1920"
        height="1200"
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    {/* Фолбэк без WebGL: размытие CSS плюс радиальная маска за курсором */}
    <div class="hero__css" data-css-hole aria-hidden="true"></div>

    {/* Мини-плашка у метки. Своя тема light: метка стоит на кадре, и плашка
        обязана быть бумажной панелью, а не выворотной надписью на тумане. */}
    <div class="hero__points" data-points>
      <div class="mini" data-mini data-theme="light" hidden>
        <p class="mini__index u-text-style-text-sm u-weight-semibold" data-mini-index></p>
        <p class="mini__title u-text-style-text-sm u-weight-semibold" data-mini-title></p>
        <p class="mini__text u-text-style-text-sm u-weight-regular u-text-secondary" data-mini-text></p>
      </div>
    </div>

    {/* Слой текста. Его клонирует hero/textmask.ts: копия лежит под маской и
        красится вторым цветом, поэтому в разметке блок ровно один и разъехаться
        двум версиям текста негде. */}
    <div class="hero__ui u-container" data-hero-ui>
      {/* Состав хедера из ТЗ: леттеринг, разделы, основная CTA. Меню — общий
          компонент: те же пункты и то же раскрытие по наведению стоят в
          фиксированной полосе, которая приходит после сцены. */}
      <header class="hero__bar">
        <p class="hero__logo u-text-style-h6" data-anim style="--i: 0">{WORDMARK}</p>
        <div class="hero__nav" data-anim style="--i: 1">
          <SiteNav />
        </div>
        <a
          class="hero__cta u-text-style-text-sm u-transform-uppercase u-weight-semibold u-bg-accent u-radius-sm"
          href={CTA.href}
          data-anim
          style="--i: 2"
        >
          {CTA.text}
        </a>
      </header>

      <div class="hero__intro">
        {/* Строки размечены явно, а не собираются измерением: переносы здесь
            дизайнерские, те же, что были <br>. Порядок входа — --i в разметке,
            как у карточек легенд: элементов ровно столько, сколько видно. */}
        <h1 class="u-text-style-h1 u-alignment-center">
          <span class="line" style="--i: 3">У берега есть</span>
          <span class="line" style="--i: 4">своя история</span>
        </h1>
        <hr class="rule hero__rule" data-anim style="--i: 5" />
        {/* Три слота под дивайдером, как в макете: «слева», «по центру», «справа».
            Тексты — из ТЗ, расположение прежнее. */}
        <div class="hero__notes">
          <p class="hero__note u-text-style-text-sm u-weight-semibold">
            <span class="line" style="--i: 6">За туманом скрываются истории природы, мест и событий.</span>
            <span class="line" style="--i: 7">Исследуйте карту и соберите все легенды</span>
          </p>
          <p class="hero__note u-text-style-text-sm u-alignment-center u-weight-semibold">
            <span class="line" style="--i: 6">Молодые российские архитекторы</span>
            <span class="line" style="--i: 7">продолжат легенду Порта Байкал</span>
          </p>
          <a class="hero__about u-text-style-text-sm u-weight-semibold u-text-accent" href="#about" data-anim style="--i: 8">
            О конкурсе
            <svg class="hero__arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </a>
        </div>
      </div>

      {/* Подпись к самой карте легенд стоит по нижней кромке кадра — на месте
          прежнего «Листайте вниз»: «исследуйте карту» относится ровно к тому,
          что под курсором, и вторая подсказка рядом читалась бы дублем. */}
      <p class="hero__map u-text-style-text-sm u-weight-semibold" data-anim style="--i: 9">
        Открой легенды Порта Байкал
      </p>
    </div>

    {/* Счётчик собранных легенд. Продолжение меток: на раскрытии они слетаются
        в одну точку, и на её месте встаёт этот круг. Слой держит общую колонку
        страницы — сцена спрашивает у плашки её место, а не считает своё. */}
    <div class="hero__tally-layer u-container" aria-hidden="true">
      <div class="hero__tally" data-tally>
        <p class="hero__tally-text u-text-style-text-sm u-weight-semibold">
          Собрано <span class="hero__tally-count" data-tally-count>0</span> из {legends.length} легенд
        </p>
      </div>
    </div>

    {/* Полные карточки: в сцене их листает скролл, без JS — просто читаются подряд.
        Тема light на самой карточке: она бумажная панель поверх кадра легенды,
        и весь её текст берёт цвет с этой темы, а не с темы секции. */}
    <div class="cards">
      {legends.map((l, i) => (
        <article
          class="card"
          id={`legend-${l.id}`}
          data-legend-card
          data-index={i}
          data-theme="light"
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          {/* data-anim + --i: очередь входа. Порядок задан здесь, а не считается
              скриптом, — элементов ровно столько, сколько видно в разметке. */}
          <p class="card__index u-text-style-h1 u-text-tertiary u-alignment-center" data-anim style="--i: 0">
            {String(i + 1).padStart(2, '0')}
          </p>
          <h2 class="card__title u-text-style-h4 u-alignment-center" data-anim style="--i: 1">
            {l.data.title}
          </h2>
          <hr class="rule card__rule" data-anim style="--i: 2" />
          {/* Текст легенды идёт одной колонкой — ровно тем, что дал заказчик.
              Второй колонки с фактологией здесь больше нет: её тексты были
              написаны на время вёрстки, а в ТЗ легенда — сплошной рассказ. */}
          <div class="card__body u-text-style-text-md" data-anim style="--i: 3"><l.Body /></div>
          <a
            class="card__more u-text-style-text-sm u-weight-semibold"
            href={`/legends/${l.id}`}
            data-anim
            style="--i: 4"
          >
            Подробнее
          </a>
        </article>
      ))}
    </div>

    {/* Экран входа. Лежит поверх всего и держит сцену закрытой: под ним туман
        без единой дыры, и вход её раскрывает. Фон — тот же --bg темы секции,
        что и плоский фон кальки, поэтому уход экрана не подменяет картинку, а
        открывает на том же цвете её белые формы.

        Обе кнопки пока делают одно и то же: звука в проекте ещё нет, выбор
        только запоминается. */}
    <div class="hero__gate" data-gate>
      <div class="hero__gate-inner u-container">
        <p class="hero__gate-title u-text-style-h2 u-alignment-center">Legend of Baikal</p>
        <div class="hero__gate-actions">
          <button
            class="hero__gate-go u-text-style-text-sm u-weight-semibold"
            type="button"
            data-gate-enter="sound"
          >
            С аудио
          </button>
          <button
            class="hero__gate-mute u-text-style-text-sm u-weight-semibold"
            type="button"
            data-gate-enter="mute"
          >
            Без звука
          </button>
        </div>
      </div>
    </div>

    {/* Финальный наплыв своего слоя в DOM не держит вовсе, и заливки под него
        больше нет: последний экран пина канвас той же маской уходит в
        прозрачность, а под дырой стоит настоящая секция «О территории» — она
        весь этот экран поднимается снизу обычным скроллом. Пин отпускает ровно
        там, где она доехала до верхней кромки. */}
  </div>
</section>

<style>
  /* Высота сцены объявлена один раз и глобально: на неё же поднимается секция
     под сценой, когда финальный наплыв открывает её из-под канваса. Второе
     такое число в другом файле разъехалось бы молча — пин отпускал бы секцию
     не там, где она доехала. */
  :global(:root) {
    --hero-h: 100vh;
    --hero-h: 100svh;
  }

  /* Слой выше страницы: секция под сценой лежит ниже по порядку рисования, и
     финальный наплыв открывает её дырой в канвасе, а не наездом сверху. */
  .hero {
    position: relative;
    z-index: 1;
    min-height: var(--hero-h);
  }

  .hero__stage {
    position: relative;
    height: var(--hero-h);
    overflow: clip;
    background: var(--bg);
    /* Курсор сцена слушает на окне, а кадр ловить нечем — и на финале канвас
       уходит в прозрачность, оставаясь поверх открывшейся секции: невидимый
       перехватчик поверх живого текста забирал бы у него и клик, и выделение.
       Интерактив внутри включает себе указатель сам — так же, как мишени
       легенд и активная карточка. */
    pointer-events: none;
  }

  /* Своего фона у сцены с канвасом нет ни на секции, ни на слое: канвас
     непрозрачен всё время, кроме финального наплыва, а там любой фон под ним и
     перекрыл бы открывшуюся страницу. Фон секции приходит от её темы, то есть
     от `data-theme`, и снять его нужно отдельным правилом.

     Условие — тот же атрибут, которым сцена разрешает перекрытие: он и значит
     «канвас умеет открыться». Фолбэку фон остаётся — под ним картинка, а не
     прозрачный канвас. Кроссфейд статики и канваса идёт под экраном входа, то
     есть под непрозрачным слоем: просвета в момент подмены не видно. */
  :global(:root[data-hero-overlap]) .hero,
  .hero__stage[data-mode='webgl'] {
    background: none;
  }

  /* ── слой текста ────────────────────────────────────────────────────────── */
  /* Раскладка первого экрана: хедер сверху, заголовок с подписями следом,
     подсказка прокрутки внизу. Между ними — свободное место кадра. */
  /* Поля и потолок ширины — от u-container, то есть те же, что у остальной
     страницы. Своего --pad у первого экрана больше нет: кадр во весь экран, а
     текст на нём обязан стоять по общей колонке. */
  .hero__ui {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-md) var(--space-xl);
    color: var(--fg);
    pointer-events: none;
  }

  .hero__ui a,
  .hero__ui button {
    pointer-events: auto;
  }

  /* Копия текста, которую открывает маска. Второй цвет — фон темы: под дырой
     светлое небо кадра, и выворотка на нём пропадает.

     Копий в разметке две, и показана всегда одна: снимок маски назначается
     скрытой, а видимость меняется, когда маска на ней уже нарисована. Смена
     маски у показанной копии даёт кадр без маски, то есть вспышку текста на
     весь экран. По той же причине здесь пустая маска, а не её отсутствие. */
  [data-hero-ui-hole] {
    color: var(--bg);
    opacity: 0;
    pointer-events: none;
    /* Подмена копий — мгновенная. Переход прозрачности от общего правила слоя
       здесь и был мерцанием: копии меняются каждые 45 мс, полсекунды анимации
       не успевают доиграть, и текст пульсирует вместо того, чтобы просто
       лежать в дыре. */
    transition: none !important;
    -webkit-mask-image: linear-gradient(#0000 0 0);
    mask-image: linear-gradient(#0000 0 0);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  /* Кнопка в копии остаётся акцентной: коралл читается и на кальке, и на
     открытом кадре, менять ему цвет не за чем. То же у ссылки «О конкурсе»:
     цвет копии задаётся правилом компонента и бьёт утилиту, поэтому акцент ей
     возвращается здесь — иначе в дыре она уходила бы в цвет фона. */
  [data-hero-ui-hole] .hero__cta {
    color: var(--accent-contrast);
  }

  [data-hero-ui-hole] .hero__about {
    color: var(--accent);
  }

  [data-hero-ui-hole] .hero__rule {
    background: var(--bg);
  }

  /* Леттеринг слева, меню по центру, CTA справа. Боковые дорожки равные, и
     именно `minmax(0, …)`: у `1fr` минимум равен min-content, и длинный пункт
     меню растянул бы свою дорожку, сдвинув центр молча и ровно на разницу. */
  /* Свой слой поверх остального текста экрана: строки заголовка идут анимацией
     по `transform`, и браузер держит их отдельным композиторским слоем — без
     явного z-index у хедера раскрытая панель меню оказывается под буквами. */
  .hero__bar {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--gutter);
  }

  .hero__logo {
    justify-self: start;
    margin: 0;
    white-space: nowrap;
  }

  .hero__nav {
    justify-self: center;
  }

  .hero__cta {
    justify-self: end;
    padding: var(--space-xs) var(--space-md);
    text-decoration: none;
    white-space: nowrap;
  }

  .hero__intro {
    margin-block-start: var(--space-2xl);
  }

  .hero__intro h1 {
    margin: 0;
  }

  /* Геометрия и отбивки — общий `.rule` (`styles/rule.css`), здесь только цвет:
     линия лежит поверх кадра, поэтому var(--fg), а не currentColor — у тёмной
     копии под маской цвет переопределён своим правилом, и наследование увело бы
     линию в фон. */
  .hero__rule {
    background: var(--fg);
  }

  /* Три подписи в строку. Сетка своя, а не u-grid-12: колонки здесь не доли
     макетной сетки, а «слева», «по центру» и «справа», и средняя обязана
     держаться середины кадра при любой ширине. */
  /* Выравнивание по базовой линии, а не по верху блока: у ссылки справа одна
     строка, у соседей две, и по верху её бы приподняло относительно их первой
     строки на разницу интерлиньяжа. */
  .hero__notes {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    gap: var(--gutter);
  }

  .hero__note {
    margin: 0;
  }

  .hero__about {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    justify-self: end;
    text-align: right;
    text-decoration: none;
  }

  .hero__arrow {
    width: 1em;
    height: 1em;
    flex: none;
  }

  /* Подпись к карте стоит по нижней кромке кадра: `auto` сверху съедает весь
     остаток высоты, поэтому между заголовком и ею лежит свободное поле кадра —
     то самое, в котором ходят метки. */
  .hero__map {
    margin: auto 0 0;
    text-align: center;
  }

  /* Текст живёт в фазе тумана: дальше кадр раскрывается и его место занимают
     карточки легенд. */
  [data-phase] .hero__ui {
    transition: opacity 0.5s var(--ease);
  }
  [data-phase='reveal'] .hero__ui,
  [data-phase='legends'] .hero__ui {
    opacity: 0;
    visibility: hidden;
  }

  .hero__canvas,
  .hero__static,
  .hero__css {
    position: absolute;
    inset: 0;
    display: block;
  }

  .hero__canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }

  .hero__static {
    transition: opacity 0.6s var(--ease);
  }

  .hero__static img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Канвас поднимается, статика уходит — только когда сцена реально готова */
  [data-ready='1'][data-mode='webgl'] .hero__canvas {
    opacity: 1;
  }
  [data-ready='1'][data-mode='webgl'] .hero__static {
    opacity: 0;
  }

  /* ── фолбэк ─────────────────────────────────────────────────────────────── */
  .hero__css {
    display: none;
  }
  [data-mode='css'] .hero__css {
    display: block;
    /* размытие снимается внутри пятна; сам кадр остаётся картинкой под ним */
    /* тот же ход, что у размытой копии в шейдере: контраст держит светлота */
    backdrop-filter: blur(18px) brightness(0.62) saturate(1.15);
    mask-image: radial-gradient(
      circle var(--r, 18vmin) at var(--x, 50%) var(--y, 50%),
      transparent 0%,
      rgb(0 0 0 / calc(var(--fog, 1) * 0.85)) 65%,
      rgb(0 0 0 / var(--fog, 1)) 100%
    );
  }

  /* ── точки-легенды ──────────────────────────────────────────────────────── */
  .hero__points {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Дальше фазы тумана метки уже улетают в счётчик, а в фазе 3 они накрыты
     кадром легенды. Кнопки над ними оставлять нельзя: невидимая мишень посреди
     чужой картинки ловит и курсор, и Tab. */
  [data-phase='reveal'] .hero__points,
  [data-phase='legends'] .hero__points,
  /* до входа мишеней нет: кадра, в который они целятся, ещё не видно */
  [data-gated]:not([data-entered]) .hero__points {
    opacity: 0;
    visibility: hidden;
  }

  :global(.hero__hit) {
    position: absolute;
    top: 0;
    left: 0;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    pointer-events: auto;
    /* сам светлячок рисует шейдер: кнопка нужна клавиатуре и поисковику */
    -webkit-tap-highlight-color: transparent;
  }

  /* Фон и цвет плашке даёт её собственная тема, здесь только геометрия. */
  .mini {
    position: absolute;
    top: 0;
    left: 0;
    max-inline-size: 18rem;
    padding: var(--space-md);
    opacity: 0;
    pointer-events: none;
    /* Та же пара, что у карточки: уход — прозрачностью, вход — клипом, и
       затухание на входе выключено, чтобы не смазывать фронт раскрытия. */
    transition: opacity 0.18s var(--ease);
  }

  .mini.is-in {
    opacity: 1;
    transition: none;
    animation: mini-in 0.4s var(--ease) both;
  }

  @keyframes mini-in {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* Текст входит следом за плашкой и по очереди — тем же ходом, что строки
     карточки: сначала номер, потом заголовок, потом тизер. */
  .mini.is-in p {
    animation: fade-up 0.4s var(--ease) both;
  }
  .mini.is-in p:nth-child(1) {
    animation-delay: 0.1s;
  }
  .mini.is-in p:nth-child(2) {
    animation-delay: 0.16s;
  }
  .mini.is-in p:nth-child(3) {
    animation-delay: 0.22s;
  }

  /* Отступы поштучно, а не сбросом `.mini p`: сброс на теге специфичнее
     классов и съедает их margin. Строки набраны с вертикальным trim и без
     отступа встают вплотную кап-высотами.

     Номер отбит от пары «заголовок + тизер»: они читаются одним блоком, он —
     отдельной меткой над ним. */
  .mini__index {
    margin: 0 0 var(--space-lg);
  }

  .mini__title {
    margin: 0 0 var(--space-xs);
  }

  .mini__text {
    margin: 0;
  }

  /* ── счётчик собранных легенд ───────────────────────────────────────────── */
  /* Слой держит колонку страницы: плашка стоит по тем же полям, что заголовок,
     и по центру экрана по вертикали. Место читает сцена — оно здесь одно. */
  .hero__tally-layer {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  /* Круг ровно размером метки: --dot ставит скрипт из DOT_SIZE сцены, второе
     число для того же круга завело бы скачок размера в момент подмены.
     Скругление pill и у круга, и у развёрнутой плашки — круг это и есть pill
     с равными сторонами, отдельного состояния для него не нужно. */
  .hero__tally {
    display: grid;
    grid-template-columns: 0fr;
    align-items: center;
    min-inline-size: var(--dot, 1.5rem);
    min-block-size: var(--dot, 1.5rem);
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--accent-contrast);
    opacity: 0;
    transition:
      grid-template-columns 0.55s var(--ease),
      padding 0.55s var(--ease);
  }

  /* Подмена канваса на DOM — мгновенная, без перехода: круги одинаковые и
     стоят в одном месте, а любое их наложение полупрозрачными читается
     вспышкой ровно там, где движение обязано быть непрерывным. */
  .hero__tally.is-on {
    opacity: 1;
  }

  /* Уход под финальным наплывом — плавный: накладываться здесь не с чем, а
     мгновенно пропавшая плашка читается сбоем, а не концом сцены. */
  .hero__tally.is-gone {
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }

  .hero__tally.is-open {
    grid-template-columns: 1fr;
    padding-block: var(--space-xs);
    padding-inline: var(--space-md);
  }

  /* 0fr режет колонку до нуля, но не содержимое: без overflow текст лежит
     поперёк экрана, пока плашка ещё круг. */
  .hero__tally-text {
    margin: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }

  /* Текст входит следом за плашкой, а не вместе с ней: в узкой щели он читается
     сплющенным. */
  .hero__tally.is-open .hero__tally-text {
    opacity: 1;
    transition-delay: 0.25s;
  }

  /* Цифра меняется с каждой легендой. Табличные цифры обязательны: без них
     плашка дёргает ширину на смене числа. */
  .hero__tally-count {
    display: inline-block;
    font-variant-numeric: tabular-nums;
  }

  .hero__tally-count.is-bump {
    animation: tally-bump 0.4s var(--ease);
  }

  @keyframes tally-bump {
    from {
      opacity: 0;
      transform: translateY(0.5em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ── карточки легенд ────────────────────────────────────────────────────── */
  /* Карточки в сцене — всегда оверлей: их листает скролл. Без JS ни одна не
     активна и они не видны, а читаемый текст лежит ниже отдельной секцией. */
  /* Колонка карточек стоит по полю страницы — тому же --margin, что у остального
     контента: своё число здесь дало бы карточку, висящую не по краю колонки.

     Слой во всю высоту кадра: карточка стоит по его середине и ходит от неё
     в обе стороны, а не отмеряется от края. */
  .cards {
    position: absolute;
    inset: 0 var(--margin) 0 auto;
    inline-size: min(34rem, 44vw);
    /* Слой ростом во весь кадр: без этого он накрывает метки легенд и забирает
       у них курсор ещё в фазе тумана. Ловит только активная карточка. */
    pointer-events: none;
  }

  /* Карточку ведёт скролл через --y, а не CSS-переход: переход живёт своё время
     и на отмотке назад отстаёт от кадра, за которым обязан идти.

     --y: +1 в начале слота, −1 в конце, со сглаженными концами — карточка
     трогается и останавливается плавно, а не рывком на границе слота. Ход
     небольшой и идёт от середины кадра в обе стороны: прокрутка обязана что-то
     двигать, но карточка при этом стоит по центру, а не отмеряется от края.

     Высота фиксированная и от контента не зависит: карточки пяти легенд разной
     длины, и подстройка под каждую превращала бы смену легенды в подскок
     панели. Число — самая высокая карточка плюс запас: контент внутри
     раскладывается сеткой, а не распирает её.

     Пересчитано под кегль абзаца на ступень крупнее (заказчик: текст легенды
     мелкий): замер самой высокой карточки дал 524 px на 901, 496 на 1100, 502
     на 1440 и 568 на 1920. Зависимость немонотонная — на узком карточка уже,
     зато на широком крупнее и кегль, и вся шкала отступов, — поэтому до 1440
     держит пол, а прямая догоняет только на последнем отрезке. Прежние 464–496
     были посчитаны под мелкий кегль и обрезали бы теперь epishura. */
  .card {
    position: absolute;
    right: 0;
    top: 50%;
    /* Сетка: колонки текста забирают остаток высоты, кнопка стоит по низу. */
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    inline-size: 100%;
    block-size: clamp(33.5rem, calc(25.25rem + 9.1667vw), 36.25rem);
    padding: var(--space-md);
    opacity: 0;
    /* --out: ход финала. Карточка уезжает вверх вместе со своим кадром — на
       финале прокрутка не встаёт, старый экран уходит наверх целиком. Ход в
       долях экрана, а не в пикселях: он обязан уводить панель за кромку при
       любой высоте окна. */
    transform: translateY(
      calc(-50% + var(--y, 1) * var(--space-3xl) - var(--out, 0) * 100svh)
    );
    pointer-events: none;
    /* Уход — только прозрачностью: карточка предыдущей легенды гаснет под
       наплывом, пока следующая раскрывается клипом. */
    transition: opacity 0.35s var(--ease);
  }

  /* Вход мгновенный по прозрачности и рисуется клипом: затухание поверх
     раскрытия смазало бы фронт, ради которого клип и взят. */
  /* Гаснет вдвое быстрее, чем идёт фронт: доехать до верхней кромки карточка
     обязана раньше, чем заливка накроет весь экран, — поверх неё бумажная
     панель читается не уходящим экраном, а забытым куском вёрстки. */
  .card.is-in {
    opacity: calc(1 - var(--out, 0) * 2);
    transition: none;
    animation: card-in 0.8s var(--ease-expo) both;
  }

  .card.is-active {
    pointer-events: auto;
  }

  /* Раскрытие от середины карточки в обе стороны: клип расходится по
     горизонтальной оси, а не наползает с края. */
  @keyframes card-in {
    from {
      clip-path: inset(50% 0 50% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* Внутренности входят целиком, а не построчно, и одной очередью: номер,
     заголовок, дивайдер, обе колонки текста, кнопка. Порядок — из --i в
     разметке. */
  .card [data-anim] {
    display: block;
  }

  .card.is-in [data-anim] {
    animation: fade-up 0.5s var(--ease-expo) both;
    animation-delay: calc(var(--i, 0) * 0.06s + 0.12s);
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(0.7em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Отступы назначены поштучно, а не сбросом `.card p`: сброс на теге
     специфичнее классов элементов и молча съедает их собственные margin. */
  /* Номер и дивайдер отбиты от заголовка одинаково: он стоит между ними, и
     разные отступы читались бы съехавшим блоком. */
  .card__index {
    margin: 0 0 var(--space-lg);
  }

  /* Дивайдер той же природы, что у заголовка первого экрана: линия во всю
     ширину колонки цветом рамки темы. Он же — прогресс легенды: поверх линии
     слева направо идёт акцентная полоса на ту же ширину, что прокручен слот.
     Второй индикатор для того же счёта заводить незачем, а линия и без того
     стоит ровно там, где взгляд ищет границу между заголовком и текстом.

     margin-inline: 0 обязателен: у hr браузерный дефолт auto, и в гриде
     авто-поля ужимают линию до нулевой ширины — правило есть, а видно его нет. */
  /* Отбивки и линия — общий `.rule`; здесь только своя роль: у карточки дивайдер
     заодно полоса прогресса легенды, и ей нужен контекст позиционирования. */
  .card__rule {
    position: relative;
  }

  .card__rule::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: calc(var(--p, 0) * 100%);
    background: var(--accent);
  }

  /* Текст легенды идёт regular: полужирный абзац базового слоя набран под
     мелочь на тумане, а здесь бумажная панель и длинный текст.

     Выключка по формату — общая для всей страницы. Последняя строка остаётся
     по левому краю сама, это дефолт `justify`. */
  .card__body :global(p) {
    margin: 0 0 var(--space-md);
    font-weight: var(--weight-regular);
    text-align: justify;
  }

  .card__body :global(p:last-child) {
    margin-block-end: 0;
  }

  /* Кнопка тёмная, а не акцентная: коралл в карточке спорил бы с метками на
     кадре, где он значит «легенда, которую ещё не открыли». */
  .card__more {
    justify-self: center;
    margin-block-start: var(--space-xl);
    padding: var(--space-xs) var(--space-2xl);
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
  }

  /* ── экран входа ────────────────────────────────────────────────────────── */
  /* Поверх всего и на весь кадр. Фон свой, а не прозрачность поверх сцены: под
     ним сцена стоит закрытой, и любой её просвет обесценил бы раскрытие. */
  .hero__gate {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    background: var(--bg);
    /* Слой сцены указателя не ловит, а экран входа обязан: он держит сцену
       закрытой, и клик мимо кнопки не должен проваливаться в страницу под ним. */
    pointer-events: auto;
    /* Фон уходит следом за своим текстом, а не вместе с ним: сначала пустеет
       экран, и только потом открывается кадр. Видимость снимается в конце —
       иначе слой продолжает ловить курсор поверх уже открытой сцены. */
    transition:
      opacity 0.5s var(--ease) 0.25s,
      visibility 0s linear 0.75s;
  }

  [data-entered] .hero__gate {
    opacity: 0;
    visibility: hidden;
  }

  .hero__gate-inner {
    display: grid;
    justify-items: center;
    gap: var(--space-lg);
    transition: opacity 0.25s var(--ease);
  }

  [data-entered] .hero__gate-inner {
    opacity: 0;
  }

  .hero__gate-title {
    margin: 0;
  }

  .hero__gate-actions {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-block-start: var(--space-md);
  }

  /* Обе кнопки берут цвет с темы секции: главная — выворотка фоном, вторая —
     тот же текст с подчёркиванием. Своих цветов у них нет. */
  /* Наследуется только гарнитура. `font: inherit` шорткатом забирал бы и кегль,
     а он приходит текстовым стилем: правило компонента лежит вне слоёв и
     перебивает утилиту молча — кнопка набиралась базовым размером. */
  .hero__gate-go,
  .hero__gate-mute {
    border: 0;
    font-family: inherit;
    cursor: pointer;
  }

  .hero__gate-go {
    padding: var(--space-xs) var(--space-2xl);
    background: var(--fg);
    color: var(--bg);
  }

  .hero__gate-mute {
    padding: var(--space-xs) 0;
    background: none;
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  /* ── вход первого экрана ────────────────────────────────────────────────── */
  /* Текст ждёт входа, и прячет его атрибут, который ставит скрипт: без JS
     экрана входа нет вовсе, и текст обязан остаться на месте.

     Правило ловит и обе копии текста под маской: они лежат в том же слое, и
     анимация у трёх копий одна — стартуют они в один кадр, потому что класс
     ставится на общего родителя, а не на каждую копию отдельно. */
  [data-gated] .hero__ui :is(.line, [data-anim]) {
    opacity: 0;
  }

  [data-entered] .hero__ui :is(.line, [data-anim]) {
    /* Долгий выход и expo.out: строка трогается заметно и почти всю дорогу
       доезжает, а не проскакивает. Кривая — тот же токен, что ведёт вход
       карточки легенды, второй такой же заводить незачем. */
    animation: fade-up 1.2s var(--ease-expo) both;
    /* Задержка — пока уходит фон экрана входа: строки, влетающие в ещё закрытый
       кадр, читаются вторым экраном поверх первого. Дальше шаг очереди. */
    animation-delay: calc(0.75s + var(--i, 0) * 0.06s);
  }

  /* Строка — блок: переносы здесь дизайнерские, и вход идёт по ним. */
  .hero__ui .line {
    display: block;
  }

  @media (max-width: 900px) {
    /* Три подписи в строку на узком экране слипаются: у левой в колонке остаётся
       по два слова (замер на 390: десять строк вместо двух). Ложатся стопкой и все
       по центру — под центрированным заголовком они и есть его подписи, а по
       левому краю блок распался бы на центрированный верх и левый низ. Выключку
       из утилит перебивает правило компонента: оно вне слоёв. */
    .hero__notes {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-md);
      justify-items: center;
    }

    .hero__note,
    .hero__about {
      justify-self: center;
      text-align: center;
    }

    /* ТЗ 1.9: пин отключается, карточка едет снизу на всю ширину */
    .cards {
      inset: auto var(--margin) var(--margin) var(--margin);
      inline-size: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__canvas {
      display: none;
    }
    .hero__static {
      opacity: 1 !important;
    }
    /* Ленты легенд здесь нет: карточку ведёт скролл-сценарий, а без него шесть
       панелей просто лягут стопкой поверх статичного кадра. Полный текст всех
       легенд лежит отдельной секцией ниже (ТЗ 2.8, 2.10). */
    .cards {
      display: none;
    }
    /* Плашка счётчика живёт вместе со сценой, которой здесь нет */
    .hero__tally-layer {
      display: none;
    }
    /* Вход остаётся точкой входа — это выбор звука, а не эффект. Уходит он и
       текст показывает без хода: движение здесь и просили убрать. */
    .hero__gate,
    .hero__gate-inner {
      transition-duration: 0.01ms;
    }
    [data-entered] .hero__ui :is(.line, [data-anim]) {
      animation-duration: 0.01ms;
      animation-delay: 0s;
    }
  }
</style>

<script>
  import { autoMount } from '../hero/index';
  autoMount();
  document.addEventListener('astro:page-load', autoMount);
</script>
