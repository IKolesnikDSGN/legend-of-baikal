---
/**
 * «О конкурсе» — блок 8 из pagemap. Состав оттуда же: заголовок, текст,
 * ключевые факты коротко, кнопка «Узнать условия» и CTA «Подать заявку».
 *
 * Тема brand, а не light: блок несёт главный CTA страницы, и коралл на
 * тёмно-синем — та же пара, что у кнопки в хедере первого экрана. Заодно даёт
 * ритм: «О территории» бумажная, эта тёмная.
 *
 * Раскладка у блока своя, и это единственный на странице отход от общей идиомы
 * (заголовок по центру, дивайдер, пункты в строку): блок ростом в экран, у него
 * дисплейный заголовок в две строки по левому краю, под дивайдером слева список
 * условий, а справа — колонка ровно в половину экрана с текстом и кнопками.
 * Центрированный заголовок здесь читался бы шапкой такой же секции, как соседние,
 * а блок обязан читаться главным разворотом страницы.
 *
 * Ключевые факты — из ТЗ, по пункту на строку. Срок подачи там стоит скобкой,
 * то есть ещё не назначен: у него значение «уточняется» и тише подписи. Вес
 * читается утверждением, и «до 15 сентября» из головы пережило бы вёрстку.
 */
const facts = [
  { label: 'Приём заявок', value: 'уточняется', pending: true },
  { label: 'Участие', value: 'Бесплатно' },
  { label: 'Награда', value: 'Грант или приз' },
  { label: 'Реализация', value: '2028 год' },
  { label: 'Выставка', value: 'Топ-10 концепций' },
];
---

<section class="about u-spacer-top-lg u-spacer-btm-lg" id="about" data-theme="brand">
  {/* Ландшафтный паттерн фона — канвас, а не картинка: линии внутри семейств
      едут вверх с разной скоростью, то есть форма пересчитывается каждый кадр.
      Устройство и числа — в `lib/topo.ts`. Декорация, поэтому `aria-hidden`. */}
  <canvas class="about__topo" aria-hidden="true"></canvas>

  <div class="about__inner">
    <header class="about__head">
      {/* Перенос стоит в разметке: две строки — композиция блока, а `text-wrap`
          делит строку по-своему на каждой ширине. На узких экранах строк станет
          больше, и это нормально: там дисплейный кегль ужат втрое.

          Уровень здесь h1, а не дисплейный, и это следствие самого текста: в нём
          есть «й», а у дисплейного стиля интерлиньяж 0.9 и вертикальный trim по
          кап-высоте — краткая не помещается. Замер на дисплейном: заголовок встал
          в три строки, и краткие «ПРИРОДОЙ» и «БАЙКАЛА» попали в зону строки выше
          и читались случайными пометками над «СОАВТОРСТВЕ». Переносом это не
          лечится — оба слова стоят в конце фразы. У h1 интерлиньяж 0.95, и место
          краткой остаётся, а из строки выше в неё заходит только зона выносных
          элементов — у прописных её нет вовсе (ни «Д», ни «Ц», ни «Щ» в первой
          строке). Текст пришёл от заказчика, менять его нельзя; дисплейный
          уровень остаётся за блоками, где «й» нет («О проекте»). */}
      <h2 class="about__title u-text-style-h1 u-alignment-center">
        Архитектура в соавторстве<br />с природой Байкала
      </h2>
      <hr class="rule rule--loose" />
    </header>

    <div class="about__row">
      {/* Факты — определения, а не просто строки: подпись и значение связаны
          разметкой, и скринридер читает их парой. */}
      <dl class="about__facts">
        {facts.map((f) => (
          <div class="fact">
            <dt class="fact__label u-text-style-text-md u-text-muted">{f.label}</dt>
            <dd
              class={`fact__value u-text-style-text-md ${
                f.pending ? 'u-text-secondary' : 'u-text-main u-weight-semibold'
              }`}
            >
              {f.value}
            </dd>
          </div>
        ))}
      </dl>

      <div class="about__lead">
        <p class="about__text u-text-style-text-md">
          Мы приглашаем молодых архитекторов, дизайнеров и урбанистов предложить
          концепцию благоустройства берега — бережную к природе, связанную с историей
          места и наполненную новыми сценариями для людей.
        </p>
      </div>

      {/* Две кнопки одного действия — узнать и подать. Вторичная обведена рамкой,
          главная залита акцентом: две заливки рядом спорят за внимание, а на этом
          блоке выбор обязан быть однозначным.

          Обе ссылки ведут на страницы, которых ещё нет, — тот же статус, что у
          «Подробнее» в карточке легенды. */}
      <div class="about__actions">
        <a class="about__more u-text-style-text-sm u-weight-semibold u-radius-sm" href="/competition">
          Узнать условия
        </a>
        <a
          class="about__cta u-text-style-text-sm u-weight-semibold u-bg-accent u-radius-sm"
          href="/apply"
        >
          Подать заявку
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { initTopo } from '../lib/topo';

  /* Флаг на узле обязателен: `astro:page-load` приходит и на первой загрузке
     тоже, и без него на одном канвасе поднялось бы два цикла. */
  const setup = () => {
    document.querySelectorAll<HTMLCanvasElement>('.about__topo').forEach((c) => {
      if (c.dataset.topo) return;
      c.dataset.topo = '1';
      initTopo(c);
    });
  };

  setup();
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  /* Отступы поштучно каждому элементу, а не сбросом `.about p`: сброс на теге
     специфичнее классов и молча съедает их собственные margin, а текст набран с
     вертикальным trim и без отступа встаёт кап-высотами вплотную. */

  /* Блок ростом в экран. `100svh`, а не `vh`: на мобильных `vh` считается по
     свёрнутой панели браузера, и блок вылезает за экран на её высоту. И это
     минимум, а не фиксированная высота — на коротком экране содержимое растит
     секцию, а не обрезается. Поля спейсеров лежат внутри этой высоты
     (`box-sizing: border-box` глобально), поэтому блок занимает ровно экран, а
     не экран плюс отбивки. */
  .about {
    position: relative;
    display: grid;
    min-block-size: 100svh;
    /* Линии уходят за кромку блока и обязаны обрезаться по ней: у настоящей
       карты высот край листа режет рисунок, а не заканчивает его. */
    overflow: clip;
    /* Свой контекст наложения: `z-index: -1` у канваса иначе уводил бы его под
       фон секции, то есть паттерн пропал бы целиком. */
    isolation: isolate;
  }

  /* Канвас лежит абсолютом, поэтому в сетке секции дорожки не занимает.
     Размеры в процентах: свои пиксели канвас получает из `lib/topo.ts` по
     `getBoundingClientRect` с учётом dpr. */
  .about__topo {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    pointer-events: none;
  }

  /* Блок идёт во всю ширину экрана за вычетом полей страницы: потолка
     `--page-max` у него нет намеренно — колонка страницы обрезала бы дисплейный
     заголовок на широких экранах, а он здесь во всю ширину и есть композиция.
     Поля — те же `--margin`, что у `u-container`, поэтому по краю страницы блок
     стоит вровень с соседними секциями, и ступеньки не видно.

     Содержимое лежит по верхней кромке, остаток высоты уходит вниз: отбивки
     дивайдера симметричны (см. ниже), и растянуть композицию по экрану значило бы
     эту симметрию сломать. */
  .about__inner {
    display: grid;
    align-content: start;
    row-gap: 0;
    padding-inline: var(--margin);
  }

  .about__title {
    margin: 0;
  }

  /* Три дорожки: условия слева, абзацы строго по центру блока, кнопки справа по
     кромке страницы.

     Середина держится сама: боковые дорожки — `minmax(0, 1fr)`, то есть ровно
     равные, и средняя стоит по центру блока при любом их содержимом. Именно
     `minmax(0, …)`, а не `1fr`: у `1fr` минимум равен min-content, и длинное
     название условия слева или широкая кнопка справа растянули бы свою дорожку,
     сдвинув центр — молча и ровно на разницу.

     Средняя дорожка `auto`, а не заданной ширины: меру держат сами абзацы (`ch`
     ниже), и дорожка встаёт по ней. Мера, вписанная сюда, считалась бы по кеглю
     секции, а он крупнее абзаца — то же число дало бы другую ширину. */
  .about__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    column-gap: var(--space-3xl);
    align-items: start;
  }

  .about__lead {
    grid-column: 2;
  }

  .about__actions {
    grid-column: 3;
    justify-self: end;
  }

  /* Условия идут списком в столбец, а не в строку: в левой половине четыре
     колонки дают по три слова на каждую.

     Набраны тем же стилем, что абзац справа, и различаются только цветом и весом:
     подпись приглушённая, значение основным цветом полужирным. Разный кегль
     читался бы вторым уровнем текста, а это одна плоскость с абзацем — просто
     короткими парами. Незаполненное значение остаётся приглушённым и без веса, то
     есть тише подписи: «уточняется» обязано быть видно ответом, которого пока нет,
     а не набранным в один голос с «2027 год». */
  .about__facts {
    display: grid;
    row-gap: var(--space-xl);
    margin: 0;
  }

  .fact {
    display: flex;
    flex-direction: column;
  }

  .fact__label {
    margin: 0 0 var(--space-2xs);
  }

  /* dd приходит с браузерным margin-inline-start: 40px — без сброса значение
     уезжает от своей подписи вправо на сорок пикселей. */
  .fact__value {
    margin: 0;
  }

  /* Мера в ch стоит на самих абзацах, а не на обёртке: ch считается по кеглю
     элемента. Оба абзаца набраны одним стилем — второй не мельче и не приглушён:
     два разных кегля читались бы лидом и сноской, а это две части одной мысли.

     Выключка по формату — следствие центрирования, а не смена решения: при рваном
     правом крае масса текста стоит левее центра дорожки (замер: 21 и 32 px на 1440),
     и абзац между условиями слева и кнопками справа читался сдвинутым. По формату
     краска занимает бокс целиком, и центр массы совпадает с центром блока.
     Последняя строка остаётся по левому краю сама — это дефолт `justify`. */
  .about__text {
    max-inline-size: 56ch;
    margin: 0 0 var(--space-lg);
    text-align: justify;
    text-wrap: pretty;
  }

  .about__text:last-child {
    margin-block-end: 0;
  }

  /* Кнопки в строку и по правой кромке страницы. Перенос разрешён: на узкой
     дорожке они встают друг под другом сами, и прижаты к тому же краю. */
  .about__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: var(--space-md);
  }

  .about__more,
  .about__cta {
    padding: var(--space-xs) var(--space-2xl);
    text-align: center;
    text-decoration: none;
  }

  .about__more {
    border: 1px solid var(--border);
  }

  @media (max-width: 1100px) {
    /* Три дорожки в одну: на планшете от боковых остаётся по трети средней, и
       центрировать абзац между двумя узкими колонками уже нечем — условия, текст
       и кнопки встают друг под другом во всю ширину. Порядок чтения тот же, что
       в разметке, поэтому переставлять нечего.

       Заодно снимаются `grid-column` со средней и правой: в одноколоночной сетке
       вторая дорожка не существует, и явная колонка увела бы блоки в неявную. */
    .about__row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-5xl);
    }

    .about__lead,
    .about__actions {
      grid-column: 1;
    }

    /* Ось блока одна, и в одной колонке она обязана остаться той же: дисплейный
       заголовок и дивайдер стоят по центру, поэтому условия, абзацы и кнопки
       встают туда же. По левому краю под центрированной шапкой они читаются
       сбитыми — блок распадается на центрированный верх и левый низ.

       Абзацам центрируется бокс, а не строки: выключка по формату остаётся, её
       и держит центровку — при рваном правом крае масса текста стояла бы левее
       центра. Мера в `ch` при этом на месте, поэтому центрировать есть что. */
    .about__facts {
      justify-items: center;
    }

    .fact {
      align-items: center;
      text-align: center;
    }

    .about__text {
      margin-inline: auto;
    }

    .about__actions {
      justify-self: center;
      justify-content: center;
    }
  }

  @media (max-width: 560px) {
    /* Кнопки в столбец и во всю ширину колонки: рядом они не встают, а
       перенесённая вторая читается обрывком строки.

       Дорожка задана явно, и без неё правило не работает вовсе: у грида без
       `grid-template-columns` единственная колонка неявная и сайзится по
       контенту, а `justify-self: stretch` растягивает по ней саму сетку, а не
       кнопки в ней. Замер на 390: кнопки стояли по 150 px при колонке 366 —
       молча, без единой ошибки. */
    .about__actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      justify-self: stretch;
      row-gap: var(--space-md);
    }
  }
</style>
