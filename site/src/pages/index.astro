---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Topbar from '../components/Topbar.astro';
import Territory from '../components/Territory.astro';
import Competition from '../components/Competition.astro';
import Footer from '../components/Footer.astro';

/**
 * Выключатель первого экрана — на время правок блоков страницы. `HERO = false`
 * снимает всё, что он держит: экран входа, мастер-кадр, пин, ленту легенд и
 * перекрытие (атрибут `data-hero-overlap` ставит `hero/scroll.ts`, поэтому
 * «О территории» сама встаёт в поток первой). Плавная прокрутка при этом
 * остаётся: Lenis живёт в лейауте, а не в сцене. `npm run check` и
 * `check:legends` при выключенной сцене не проходят — им нечего мерить.
 */
const HERO = true;
---

<Base
  title="Легенда озера Байкал"
  description="Архитектурный конкурс «Бережно»: концепция благоустройства берега Порта Байкал. Легенды маяка, Кругобайкальской дороги, эпишуры, звона над водой и завода."
>
  {/* Фиксированный хедер стоит до содержимого: он лежит поверх страницы и
      приходит, когда до линии под верхней кромкой доезжает всё, что под сценой. */}
  <Topbar />

  {HERO && <Hero />}

  {/* Метка для фиксированного хедера — вся страница под сценой одним узлом.
      Обёртка без своих стилей: отрицательное поле «О территории» сквозь неё
      схлопывается, и раскладка остаётся прежней.

      Блоки «Голосование» и «О проекте и организаторах» заказчик снял с главной.
      Они не удалены — лежат готовыми в `site/backup/components/`, там же
      написано, как их вернуть. Папка вне `src/`, поэтому в сборку не попадает. */}
  <div data-below-hero>
    <Territory />
    <Competition />
    {/* Футер живёт на странице, а не в Base: внутренних страниц ещё нет, а его
        ссылки уже написаны абсолютными (`/#territory`) — переезд в лейаут будет
        одной строкой, когда страницы появятся. */}
    <Footer />
  </div>
</Base>
