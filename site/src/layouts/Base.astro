---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#004995" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* KV грузится первым: это LCP страницы (ТЗ 2.7, бюджет < 2.5 s на 4G) */}
    <link
      rel="preload"
      as="image"
      href="/kv/kv-fullbleed-1920.avif"
      type="image/avif"
      fetchpriority="high"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="visually-hidden" href="#territory">К содержанию</a>
    <slot />

    {/* Плавная прокрутка — свойство всего сайта, а не первого экрана: раньше
        экземпляр создавала сцена, и на страницах без неё инерции не было вовсе.
        Экземпляр один и идемпотентный, сцена его только подписывает. */}
    <script>
      import { initSmooth } from '../lib/smooth';

      initSmooth();
      document.addEventListener('astro:page-load', () => initSmooth());
    </script>
  </body>
</html>
