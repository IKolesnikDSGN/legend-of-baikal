---
import { readFileSync } from 'node:fs';

import { PHOTOS, VOTE_PHOTOS, photo } from '../lib/photos';

/**
 * «Голосование» — блок 9 из pagemap. Состояний три, и все три свёрстаны:
 * до старта (отсчёт до открытия), во время (отсчёт до закрытия и кнопка на
 * проекты), после (кнопка на результаты).
 *
 * Чем состояние переключается в продакшне — решаем позже. Пока в DOM лежат все
 * три панели, показана одна, а выбор делает служебный переключатель: иконка
 * настройки у левой кромки блока и поп-ап под ней. Он же пишет состояние в адрес
 * (`?voting=during`), поэтому ссылкой на конкретный вариант можно поделиться с
 * заказчиком, не собирая сборку под каждый.
 *
 * Порядок в панели: заголовок (уровень h5, в две строки, по центру), дивайдер,
 * отсчёт во всю ширину и под ним пояснение — колонкой по центру блока, выключка
 * левая. Заголовок мелкий намеренно: главный объект блока — отсчёт, и крупный
 * заголовок спорил бы с ним за внимание. По центру он стоит по просьбе заказчика,
 * и это ставит всю ось блока в одну линию: заголовок, подписи отсчёта, строка под
 * ним и колонка текста.
 *
 * ВРЕМЕННО: даты условные, чтобы отсчёт было видно живым. Настоящие приходят из
 * положения о конкурсе — просто поставить их сюда. Пустая строка вместо даты
 * по-прежнему работает: отсчёт встаёт с прочерками.
 *
 * Формат обязателен со смещением (`+08:00` — Иркутск), иначе браузер посетителя
 * прочитает дату в своём часовом поясе и покажет чужой отсчёт.
 */
const STARTS_AT = '2026-09-25T12:00:00+08:00';
const ENDS_AT = '2026-10-20T12:00:00+08:00';

const STATES = [
  { id: 'before', label: 'До старта' },
  { id: 'during', label: 'Идёт' },
  { id: 'after', label: 'Завершено' },
];

/** Состояние по умолчанию — то, что видно без JS и в первом кадре. */
const DEFAULT_STATE = 'during';

const units = [
  { key: 'days', label: 'дни' },
  { key: 'hours', label: 'часы' },
  { key: 'minutes', label: 'минуты' },
];

/**
 * Коллаж вокруг отсчёта: два портретных кадра по бокам от набора и широкий под
 * ним, ровно по ширине текста. Боковые лежат поверх отсчёта — это и есть приём:
 * набор идёт от кромки до кромки, кадры перекрывают его крайние разряды, и блок
 * читается композицией, а не таблицей чисел.
 *
 * ВРЕМЕННО кадры — фотографии-заглушки (`lib/photos.ts`). Ляжет съёмка — меняется
 * только источник: бокс, пропорция и параллакс остаются. Ветка с рендерами
 * пайплайна стоит рядом и работает: `PHOTOS = false`.
 *
 * Ширины рендеров приходят манифестом — это набор реально собранных файлов, и
 * вписывать их числами в компонент нельзя.
 */
const manifest = JSON.parse(
  readFileSync(new URL('../../public/kv/manifest.json', import.meta.url), 'utf8'),
) as { legendWidths: number[] };

const shotWidths = [...manifest.legendWidths].sort((a, b) => a - b);
const shotSrcset = (id: string) =>
  shotWidths.map((w) => `/kv/legends/${id}-${w}.webp ${w}w`).join(', ');

/** Рендер на каждое место коллажа. Три разных: одинаковые кадры по бокам от
    одного набора читались бы техническим повтором, а не парой. */
const SHOTS = { start: 'bell', end: 'epishura', wide: 'lighthouse' };

/** `sizes` — по фактическому месту кадра в раскладке (см. стили): боковые стоят
    колонкой в 20rem и на узком экране уходят вовсе, широкий идёт по ширине
    текста. */
const SIZES = {
  start: '20rem',
  end: '20rem',
  wide: '(max-width: 900px) 100vw, 40rem',
};

/** Источники одного кадра коллажа: заглушка или рендер пайплайна. Собраны здесь,
    чтобы в разметке стоял один `img` на место, а не две ветки на каждое. */
const shot = (slot: keyof typeof SHOTS) =>
  PHOTOS
    ? { src: photo(VOTE_PHOTOS[slot]), srcset: undefined, sizes: undefined }
    : {
        src: `/kv/legends/${SHOTS[slot]}-${shotWidths[0]}.webp`,
        srcset: shotSrcset(SHOTS[slot]),
        sizes: SIZES[slot],
      };
---

<section
  class="voting u-spacer-top-lg u-spacer-btm-lg"
  id="voting"
  data-theme="light"
  data-voting
  data-state={DEFAULT_STATE}
>
  {/* ВРЕМЕННЫЙ переключатель: способ выбирать состояние, пока не решено, кто его
      назначает в продакшне — дата, флаг в контенте или админка.

      Спрятан под иконку настройки и стоит абсолютом у левой кромки по центру
      блока: он служебный и уйдёт вместе с решением, поэтому в композиции его быть
      не должно вовсе. Раньше он стоял строкой над блоком и читался частью
      вёрстки — заказчик на это и указал.

      Без JS он бесполезен и поэтому скрыт: показывать кнопки, которые ничего не
      делают, хуже, чем не показывать их вовсе. */}
  <div class="switch" data-voting-switch hidden>
    <button
      class="switch__icon"
      type="button"
      aria-expanded="false"
      aria-controls="voting-switch-pop"
      data-voting-toggle
    >
      {/* Шестерёнка: обод, зубья толстым штрихом и втулка. Тонкие лучи вместо
          зубьев читались бы солнцем, то есть переключателем темы. */}
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle class="switch__gear" cx="12" cy="12" r="6" />
        <circle cx="12" cy="12" r="2.4" />
        <path
          class="switch__teeth"
          d="M12 3.4v2.2M12 18.4v2.2M20.6 12h-2.2M5.6 12H3.4M18.1 5.9l-1.6 1.6M7.5 16.5l-1.6 1.6M18.1 18.1l-1.6-1.6M7.5 7.5L5.9 5.9"
        />
      </svg>
      <span class="u-visually-hidden">Состояние блока — временный переключатель</span>
    </button>

    <div class="switch__pop" id="voting-switch-pop" hidden>
      <p class="switch__label u-text-style-eyebrow-xs u-text-secondary">
        Временный переключатель состояния
      </p>
      <div class="switch__row" role="group" aria-label="Состояние блока голосования">
        {STATES.map((s) => (
          <button
            class="switch__btn u-text-style-text-sm u-weight-semibold"
            type="button"
            data-voting-set={s.id}
            aria-pressed={s.id === DEFAULT_STATE ? 'true' : 'false'}
          >
            {s.label}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="u-container">
    {/* ── до старта ─────────────────────────────────────────────────────────── */}
    <div class="vote" data-voting-panel="before" hidden>
      <h2 class="vote__title u-text-style-h5 u-alignment-center">До старта<br />голосования</h2>
      <hr class="rule" />

      {/* Отсчёт до открытия. Цифры табличные: без них на смене минуты вся строка
          дёргает ширину. Прочерки стоят до тех пор, пока не назначена дата —
          скрипт подставляет числа только тогда, когда ему есть что считать. */}
      <div class="timer" data-timer data-target={STARTS_AT}>
        <div class="timer__grid" aria-hidden="true">
          {units.map((u, i) => (
            <>
              {i > 0 && <span class="timer__sep">:</span>}
              <span class="timer__num" data-timer-seg={u.key}>--</span>
            </>
          ))}
          {units.map((u) => (
            <span class={`timer__cap timer__cap--${u.key} u-text-style-text-sm u-text-main`}>
              {u.label}
            </span>
          ))}
        </div>
        {/* Строка под отсчётом — что именно он считает. Тем же стилем, что подписи
            разрядов: это одна плоскость служебных подписей отсчёта, и второй кегль
            читался бы вторым уровнем текста. */}
        <p class="timer__note u-text-style-text-sm u-text-main">до старта голосования</p>
        {/* Отсчёт скринридеру читается строкой, а не по ячейкам: сама сетка для
            него скрыта — вслух «12 : 04 : 37» не значит ничего. */}
        <p class="u-visually-hidden" data-timer-sr>До старта голосования: дата уточняется</p>
      </div>

      {/* Пояснение под отсчётом: колонка по центру блока, выключка левая. Мера в
          `ch` на самих абзацах — `ch` считается по кеглю элемента. */}
      <div class="vote__lead">
        <p class="vote__text u-text-style-text-md">
          Следите за конкурсом: пока идёт приём заявок, здесь пусто — и это нормально.
          Голосование открывается после того, как жюри отберёт финалистов, и в этот
          блок встанут их концепции: планировки берега, разрезы, виды и короткие
          пояснения авторов.
        </p>
        <p class="vote__text u-text-style-text-md">
          Голос будет один, поэтому смотреть стоит внимательно: у проектов разные
          ставки — где-то это работа с водой и рельефом, где-то с портом, рельсами и
          посёлком, который тут живёт круглый год. Отсчёт выше показывает, сколько
          осталось до открытия.
        </p>
      </div>
    </div>

    {/* ── идёт голосование ──────────────────────────────────────────────────── */}
    <div class="vote" data-voting-panel="during">
      <h2 class="vote__title u-text-style-h5 u-alignment-center">Выберите будущее<br />берега</h2>
      <hr class="rule" />

      {/* Коллаж и отсчёт лежат в одной сетке: три дорожки — боковые кадры по
          краям, набор во всю ширину поверх них, текст и широкий кадр строго по
          центру. Одна сетка, а не абсолюты: место боковых кадров задают её
          крайние дорожки, то есть остаток от меры текста, — и разъезжаться с
          набором им нечем. */}
      <div class="vote__stage">
        {/* Тот же отсчёт, но до закрытия: пока голосование идёт, важно не «сколько
            прошло», а сколько осталось. */}
        <div class="timer" data-timer data-target={ENDS_AT}>
          <div class="timer__grid" aria-hidden="true">
            {units.map((u, i) => (
              <>
                {i > 0 && <span class="timer__sep">:</span>}
                <span class="timer__num" data-timer-seg={u.key}>--</span>
              </>
            ))}
            {units.map((u) => (
              <span class={`timer__cap timer__cap--${u.key} u-text-style-text-sm u-text-main`}>
                {u.label}
              </span>
            ))}
          </div>
          {/* Та же строка, но по своему состоянию: здесь отсчёт идёт до закрытия, и
              «до старта голосования» под ним было бы неправдой. */}
          <p class="timer__note u-text-style-text-sm u-text-main">до конца голосования</p>
          <p class="u-visually-hidden" data-timer-sr>До конца голосования: дата уточняется</p>
        </div>

        {/* Боковые кадры. `alt` пустой намеренно: это заглушки, а не съёмка
            берега, и описать их как берег значило бы соврать в самом доступном
            слое. Смещение по вертикали у каждого своё и параллакс — в разные
            стороны: пара, стоящая на одной высоте и едущая в одну сторону,
            читается двумя половинами одной плашки. */}
        <div class="photo vote__side vote__side--start">
          <img {...shot('start')} alt="" loading="lazy" decoding="async" />
        </div>
        <div class="photo vote__side vote__side--end">
          <img {...shot('end')} alt="" loading="lazy" decoding="async" />
        </div>

        <div class="vote__lead">
          <p class="vote__text u-text-style-text-md">
            Изучите проекты финалистов и поддержите концепцию, которая лучше всего
            сохраняет характер места и открывает его людям. Отсчёт выше показывает,
            сколько осталось до закрытия голосования.
          </p>
          <p class="vote__text u-text-style-text-md">
            Голос один и его нельзя переиграть, поэтому имеет смысл пройти по всем
            проектам целиком: у каждого есть разрезы, виды и пояснение автора о том,
            что он оставляет на берегу как есть, а что достраивает.
          </p>
        </div>

        {/* Широкий кадр ровно по ширине текста: он стоит в той же дорожке, и
            ширина приходит от меры набора, а не задана числом. */}
        <div class="photo vote__wide">
          <img {...shot('wide')} alt="" loading="lazy" decoding="async" />
        </div>

        <div class="vote__actions">
          <a
            class="vote__cta u-text-style-text-sm u-weight-semibold u-bg-accent u-radius-sm"
            href="/voting"
          >
            Смотреть проекты
          </a>
        </div>
      </div>
    </div>

    {/* ── голосование завершено ─────────────────────────────────────────────── */}
    <div class="vote" data-voting-panel="after" hidden>
      <h2 class="vote__title u-text-style-h5 u-alignment-center">Берег выбрал<br />свой проект</h2>
      <hr class="rule" />

      <div class="vote__lead">
        <p class="vote__text u-text-style-text-md">
          Спасибо всем, кто голосовал. Итоги открыты: смотрите, какая концепция
          набрала больше голосов и что будет с ней дальше.
        </p>
      </div>
      <div class="vote__actions">
        <a
          class="vote__cta u-text-style-text-sm u-weight-semibold u-bg-accent u-radius-sm"
          href="/voting/results"
        >
          Смотреть результаты
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Панели лежат в потоке одна за другой, показана всегда одна — hidden. Без
     этого правила hidden проигрывает любому display от раскладки, и скрытая
     панель остаётся на экране. */
  [data-voting-panel][hidden],
  [data-voting-switch][hidden],
  .switch__pop[hidden] {
    display: none;
  }

  /* Секция — точка привязки для абсолютного переключателя. */
  .voting {
    position: relative;
  }

  /* ── переключатель ────────────────────────────────────────────────────────── */
  /* У левой кромки по центру блока. Поле — то же `--margin`, что у колонки
     страницы: иконка стоит в поле, а не в тексте, и от кромки экрана отбита так
     же, как всё остальное. */
  .switch {
    position: absolute;
    /* Прижата к самой кромке блока: служебной кнопке место у края, а не в поле
       колонки. Восемь пикселей — шаг шкалы (`--space-2xs`), не число. */
    inset-inline-start: var(--space-2xs);
    inset-block-start: 50%;
    translate: 0 -50%;
    z-index: 1;
  }

  /* Иконка приглушена и проявляется под курсором: служебная кнопка не должна
     ловить взгляд раньше содержимого блока. */
  .switch__icon {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    padding: 0;
    border: 1px dashed var(--muted-tertiary);
    border-radius: var(--radius-pill);
    background: none;
    color: var(--muted-secondary);
    cursor: pointer;
    transition:
      color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .switch__icon:hover,
  .switch__icon:focus-visible,
  .switch__icon[aria-expanded='true'] {
    border-color: var(--muted);
    color: var(--fg);
  }

  .switch__icon svg {
    inline-size: 1.125rem;
    block-size: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: butt;
  }

  /* Зубья толще обода — на 18 px это и отличает шестерёнку от солнца. */
  .switch__teeth {
    stroke-width: 2.6;
  }

  /* Поп-ап раскрывается вправо от иконки и лежит поверх содержимого: он
     служебный, и место под себя в потоке ему выделять незачем. Пунктир — та же
     отбивка, что у пустых слотов логотипов: читается временным. */
  .switch__pop {
    position: absolute;
    inset-inline-start: calc(100% + var(--space-2xs));
    inset-block-start: 50%;
    translate: 0 -50%;
    inline-size: max-content;
    padding: var(--space-xs);
    border: 1px dashed var(--muted-tertiary);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }

  .switch__label {
    margin: 0 0 var(--space-2xs);
  }

  .switch__row {
    display: flex;
    gap: var(--space-2xs);
  }

  /* Наследуется только гарнитура: `font: inherit` шорткатом забрал бы и кегль,
     а он приходит текстовым стилем — правило компонента лежит вне слоёв и
     перебило бы утилиту молча. */
  .switch__btn {
    padding: var(--space-3xs) var(--space-xs);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: none;
    color: var(--fg);
    font-family: inherit;
    cursor: pointer;
  }

  .switch__btn[aria-pressed='true'] {
    background: var(--fg);
    color: var(--bg);
  }

  /* ── панель состояния ─────────────────────────────────────────────────────── */
  /* Отступы поштучно каждому элементу, а не сбросом `.vote p`: сброс на теге
     специфичнее классов и съедает их собственные margin, а текст набран с
     вертикальным trim и без отступа встаёт кап-высотами вплотную. */
  /* Панель начинается заголовком: надзаголовков над h2 на странице нет ни в одной
     секции — заказчик их снял. Состояние голосования при этом читается самим
     заголовком: «скоро появятся», «выберите», «берег выбрал».

     Перенос в две строки стоит в разметке: у мелкого кегля строка сама не
     переносится, а две строки здесь — композиция шапки. */
  .vote__title {
    margin: 0;
  }

  /* Пояснение под отсчётом: колонка строго по центру блока, выключка левая. */
  .vote__lead {
    margin-block-start: var(--space-6xl);
  }

  /* Меру держит `ch` на самих абзацах, а не на обёртке: `ch` считается по кеглю
     элемента, а обёртка набрана другим — то же число дало бы другую ширину.
     Центрирует поэтому каждый абзац сам, автополями.

     Обёртке центрирование не поручить: `justify-content: center` у неё ничего не
     даёт — дорожка сайзится по max-content абзаца, то есть по всей ширине блока, и
     колонка вставала по левому краю. Это и было видно. */
  /* Выключка по формату, и это не смена решения, а следствие центрирования: при
     рваном правом крае масса текста стоит левее центра бокса — замер давал 711 при
     центре 720, а последняя строка кончалась за 470 px до правой кромки, и абзац
     читался сдвинутым влево. По формату краска занимает бокс целиком, и центр массы
     совпадает с центром блока. Последняя строка при этом остаётся по левому краю
     сама — это дефолт `justify`, растягивать её не надо.

     `text-wrap: balance` тут не годится вовсе: он ровняет длины строк, но бокс
     остаётся своей ширины, и масса уезжает влево ещё сильнее (замер: центр 660). */
  .vote__text {
    max-inline-size: 64ch;
    margin: 0 auto var(--space-xl);
    text-align: justify;
    text-wrap: pretty;
  }

  .vote__text:last-child {
    margin-block-end: 0;
  }

  /* ── коллаж вокруг отсчёта ────────────────────────────────────────────────── */
  /* Три дорожки: боковые кадры по краям, набор во всю ширину, текст и широкий
     кадр строго по центру. Середина `auto` — меру держат сами абзацы (`ch` на
     них), а боковые дорожки берут остаток и потому равны: `minmax(0, 1fr)`, а не
     `1fr`, — у `1fr` минимум равен min-content, и кадр растянул бы свою дорожку,
     сдвинув центр молча и ровно на разницу.

     Набор лежит во всех трёх дорожках, боковые кадры — в крайних и в тех же
     строках: этим они его и перекрывают, без единого абсолюта. Порядок наложения
     задан явно — у сетки свой контекст, у кадров `z-index`: набор набирается
     скриптом и в потоке идёт позже, то есть по умолчанию лёг бы поверх. */
  .vote__stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    column-gap: var(--space-2xl);
    align-items: start;
    isolation: isolate;
  }

  .vote__stage > .timer {
    grid-area: 1 / 1 / 2 / -1;
  }

  .vote__stage > .vote__lead,
  .vote__wide,
  .vote__stage > .vote__actions {
    grid-column: 2;
  }

  /* Боковые кадры стоят в строках текста, а не набора, и это и держит перекрытие
     в узде: кромка их дорожки совпадает с нижней кромкой отсчёта на любой ширине,
     поэтому отсчёт растёт вместе с блоком, а кадры за ним не тянутся. Стояли они в
     строке набора — на широком экране цифры уходили под них целиком.

     Дальше их разводит `--y`: левый заходит кромкой на низ цифр, правый не касается
     отсчёта нигде. Случайное положение при каждой загрузке нельзя сверить
     скриншотом, а «хаотично» здесь значит «не на одной высоте».

     Ширина — своя дорожка, но не шире 18rem: во всю дорожку кадр накрывал бы
     крайний разряд целиком, а перекрытие обязано читаться наложением, а не
     заслонкой. */
  .vote__side {
    grid-row: 2 / 4;
    z-index: 1;
    inline-size: min(100%, 18rem);
    aspect-ratio: 2 / 3;
    translate: 0 var(--y);
  }

  /* Внутреннего параллакса у боковых кадров нет: едет сама обёртка вместе с
     кадром. Картинка, ползающая внутри неподвижного бокса, — другой приём, и два
     хода в одном месте гасят друг друга: обёртка идёт вверх, картинка в ней вниз,
     и на глаз стоит либо то, либо другое. Заодно снимается увеличение: без хода
     запас под него не нужен, а кроп кадра от него только теснее. */
  .vote__side > img {
    scale: 1;
    animation: none;
  }

  /* Смещения у кадров устроены по-разному, и это не небрежность: у них разные
     условия.

     У левого закреплена **середина пути** — `--y` числом. Требование к нему мягкое:
     он должен немного заходить на цифры, а насколько именно — вопрос вида. Замер на
     1440: пока отсчёт стоит в кадре, перекрытие идёт от нуля до 40 px (на высоком
     экране 14–65 px), к выходу блока доходит до 113 px — но там отсчёта уже не видно.

     У правого закреплена **верхняя точка**: в `--y` прибавлен сам ход, поэтому
     `--y − --drift` от амплитуды не зависит вовсе и всегда равен 8% его высоты ниже
     кромки отсчёта. Требование тут жёсткое — не коснуться отсчёта ни в одной точке,
     а ход задан в `svh` и на высоком экране растёт: закреплённой серединой замер
     давал зазор 5 px на 900 и −31 px на 1300, то есть кадр уезжал под цифры. С
     закреплённой верхней точкой зазор 35 px на всех высотах.

     Дорожка боковых кадров начинается ровно по кромке отсчёта: отбивка текста
     (`--space-6xl`) лежит внутри строки, на самом абзаце, а не гэпом сетки. */
  .vote__side--start {
    --y: -14%;

    grid-column: 1;
    justify-self: start;
  }

  .vote__side--end {
    --y: calc(var(--drift, 0px) + 8%);

    grid-column: 3;
    justify-self: end;
  }

  /* Параллакс в разные стороны: левый кадр идёт вверх, правый вниз — той же
     анимацией, развёрнутой `animation-direction`. Второй набор кейфреймов
     разъехался бы с первым на первой же правке амплитуды.

     Ход идёт от смещения кадра в обе стороны: 9svh даёт 162 px пути на экране 900 и
     234 px на 1300 — обёртка едет целиком, вместе с кадром, и это видно. Прибавлять
     дальше некуда без пересчёта смещений: левый кадр начнёт накрывать цифры целиком.

     Прогресс считает браузер по `view()`-таймлайну: своего слушателя скролла нет
     намеренно — рядом с Lenis он был бы вторым и на каждый кадр. Без таймлайна
     кадры просто стоят на своих местах: та же анимация по обычному времени уехала
     бы в свой конец насовсем. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .vote__side {
        --drift: 9svh;

        animation-name: vote-drift;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }

      .vote__side--end {
        animation-direction: reverse;
      }
    }
  }

  @keyframes vote-drift {
    from {
      translate: 0 calc(var(--y) + var(--drift));
    }

    to {
      translate: 0 calc(var(--y) - var(--drift));
    }
  }

  /* Широкий кадр — ровно по ширине текста: он стоит в той же дорожке, и ширина
     приходит от меры набора, а не задана числом. Пропорция на боксе: картинка
     внутри лежит абсолютом и своей высоты боксу не отдаёт. */
  .vote__wide {
    inline-size: 100%;
    margin-block-start: var(--space-3xl);
    aspect-ratio: 3 / 2;
  }

  /* ── отсчёт ───────────────────────────────────────────────────────────────── */
  /* Кегль считается от ширины блока, а не от вьюпорта: `cqw` берёт её у самого
     контейнера, поэтому за потолком колонки (`--page-max`) отсчёт перестаёт
     расти вместе с ним. На `vw` он продолжал бы расти и вылез бы за колонку.

     Считается он от числа знаков, а не задан числом: у отсчёта дальше 99 дней
     разрядов семь, а не шесть, и фиксированный кегль вылез бы за дорожку. `--chars`
     ставит скрипт по тому, что он реально написал. Делитель замерен: табличная
     цифра этой гарнитуры занимает 0.6 кегля, и ещё 0.01 на знак уходит на два
     мелких двоеточия с их полями. Замер: цифры занимают 436 px из 445 дорожки, то
     есть по 4 px воздуха до разделителя. Меняешь гарнитуру или поля двоеточия —
     пересчитывай: на голом 0.6 цифры налезали на разделитель. */
  .timer {
    container-type: inline-size;
  }

  .timer__grid {
    display: grid;
    /* Три равные дорожки под числа и две по контенту под двоеточия. Равные — это и
       есть «фиксированное положение» двоеточий: они стоят на границах третей и не
       ездят вслед за шириной цифр. */
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    row-gap: var(--space-md);
  }

  /* Цифры: табличные обязательны — без них смена минуты дёргает ширину строки.

     Трекинг плотный, но не любой: у табличной цифры этой гарнитуры ширина знака
     0.62em, а самая широкая краска (ноль) — 0.49em, то есть пазух около 0.13em на
     знак. Минус 0.11em съедает их почти целиком: замер на 1440 даёт ячейку 194 px
     против краски нуля 183 px, то есть 11 px между цифрами. Дальше подбирать нельзя
     на глаз — первыми слипнутся широкие 0 и 8. */
  .timer__num {
    /* Трекинг живёт одним числом: он же возвращается полем в конце числа (см.
       ниже), и разъехаться эти два места не должны. */
    --tracking: 0.11em;

    display: flex;
    justify-content: center;
    font-size: calc(100cqw / (var(--chars, 6) * 0.61));
    line-height: 1;
    font-weight: var(--weight-medium);
    font-variant-numeric: tabular-nums;
    letter-spacing: calc(var(--tracking) * -1);
    white-space: nowrap;

    /* Возврат трекинга в конце числа. Трекинг сидит после каждого знака, включая
       последний, поэтому бокс числа короче своей краски с правого края: центрируя
       бокс, браузер ставит краску правее центра дорожки ровно на половину трекинга
       (замер: 20 px на 1440 — «часы» стояли не по середине). Поле возвращает эту
       долю, и центр краски совпадает с центром дорожки. */
    padding-inline-end: var(--tracking);
  }

  /* У последнего числа поле снимается обратно: иначе краска кончалась бы на
     полтрекинга раньше правой кромки блока, к которой оно прижато. */
  .timer__num:last-of-type {
    margin-inline-end: calc(var(--tracking) * -1);
  }

  /* Крайние числа прижаты к кромкам блока, среднее по центру своей дорожки: от
     плотного трекинга каждое число стало уже дорожки, и центрированные они
     отошли бы от краёв. Разнесены — значит отсчёт стоит от кромки до кромки, а
     слак ушёл к двоеточиям. */
  .timer__num:first-of-type {
    justify-content: start;
  }

  .timer__num:last-of-type {
    justify-content: end;
  }

  /* Двоеточие своим кеглем, мелким: на кегле чисел оно заняло бы место третьего
     разряда. Цвет основной, а не приглушённый, — при таком кегле приглушённый знак
     между тремя огромными числами просто теряется. По вертикали — по центру числа:
     на базовой линии мелкий знак под трёхсотпиксельной цифрой читается
     провалившимся. */
  .timer__sep {
    padding-inline: var(--space-2xs);
    color: var(--fg);
    font-size: var(--h-sm);
    line-height: 1;
  }

  /* Знак: маска по вертикали у ячейки, лента с цифрами внутри. Один элемент не
     может разом обрезать себя и уезжать из себя, поэтому узлов два. Высота ячейки
     ровно в одну цифру — по ней же считается шаг ленты.

     Селекторы обёрнуты в `:global`, и это обязательно: ячейки и ленту создаёт
     скрипт, а скоуп Astro метит только узлы шаблона. Без `:global` правила не
     доходили вовсе — спаны оставались `display: inline`, а к инлайну трансформ не
     применяется, то есть лента стояла на месте молча, без единой ошибки. Скоуп при
     этом не потерян: снаружи стоит `.timer__num` из шаблона. */
  .timer__num :global(.timer__ch) {
    display: block;
    block-size: 1em;
    overflow: clip;
    /* Припуск справа с обратным полем. От плотного трекинга ячейка стала уже самой
       краски, а `overflow: clip` режет по её кромке — правый край цифры срезался
       ровно на разницу (замер: 10 px). Припуск расширяет окно, обратное поле
       возвращает бокс к прежней ширине, поэтому соседние знаки не разъезжаются.
       Только справа: трекинг сидит в конце знака, слева пазуха знака нетронута, а
       припуск слева уводил бы первое число за кромку блока. */
    padding-inline-end: 0.08em;
    margin-inline-end: -0.08em;
  }

  /* Лента: случайные цифры и целевая последней. Стоит она сразу на целевой — без
     скрипта и при `prefers-reduced-motion` отсчёт виден нормальным числом, а
     набор только отматывает ленту к началу и отпускает. */
  .timer__num :global(.timer__reel) {
    display: block;
    will-change: transform;
  }

  .timer__num :global(.timer__reel > span) {
    display: block;
    block-size: 1em;
  }

  /* Подписи лежат в первой строке, над своими числами, а числа с двоеточиями — во
     второй. Строки заданы явно обоим: автоматическое размещение расставило бы
     подписи подряд — над числом, над двоеточием и над следующим числом, — а числа
     ушли бы в свободные ячейки той же строки.

     Над отсчётом, а не под ним, они стоят по двум причинам. Подпись читается
     раньше числа — «дни» и потом «66», а не наоборот; и низ отсчёта остаётся
     свободным под боковые кадры коллажа: они заходят на цифры снизу, и подписи там
     уходили под них целиком (видна оставалась одна «часы»).

     Набраны они строчными и основным цветом (`text-sm`, `--fg`), а не капителью
     надзаголовка: у отсчёта своя плоскость подписей, и строка под ним набрана тем
     же стилем. */
  .timer__num,
  .timer__sep {
    grid-row: 2;
  }

  .timer__cap {
    grid-row: 1;
    margin: 0;
    text-align: center;
  }

  .timer__cap--days {
    grid-column: 1;
  }
  .timer__cap--hours {
    grid-column: 3;
  }
  .timer__cap--minutes {
    grid-column: 5;
  }

  /* Строка под отсчётом стоит по центру блока, а не по центру среднего разряда:
     она относится ко всему отсчёту, а не к «часам». Отбивка та же, что между
     подписями и числами внутри сетки, — служебные подписи отсчёта стоят одним
     шагом. */
  .timer__note {
    margin: var(--space-md) 0 0;
    text-align: center;
  }

  /* Кнопка идёт под широким кадром и по центру его ширины: композиция панели
     центрированная, и кнопка по левому краю под симметричным кадром читалась бы
     сбитой. В панели «завершено» кадра нет, и ряд там встаёт по левому краю —
     единственный объект блока не нуждается в центровке. */
  .vote__actions {
    display: flex;
    margin-block-start: var(--space-2xl);
  }

  .vote__stage > .vote__actions {
    justify-content: center;
  }

  .vote__cta {
    padding: var(--space-xs) var(--space-2xl);
    text-decoration: none;
  }

  @media (max-width: 1100px) {
    /* Боковые кадры уходят вовсе: от них остаётся по полоске в палец у краёв, а
       набор и текст важнее коллажа. То же решение, что у кадров сцены
       «О территории» на узком экране.

       Дорожки при этом остаются те же, и это не лень: середину держат сами
       абзацы, и широкий кадр под ними обязан стоять их шириной на любом экране.
       Сложи сетку в одну колонку — кадр растянулся бы во всю страницу и перестал
       бы совпадать с текстом. Пустые боковые дорожки схлопываются в ноль сами:
       у них `minmax(0, 1fr)`. */
    .vote__side {
      display: none;
    }
  }

  @media (max-width: 900px) {
    /* Переключатель уводится в поток над блоком: у левой кромки узкого экрана он
       налезает на текст.

       `relative`, а не `static`, и это условие, а не вкус: поп-ап лежит
       абсолютом от иконки, и на `static` он отсчитывался бы от секции — то есть
       от `inset-inline-start: 100%` её ширины. Замер: на 390 поп-ап стоял на 398
       и уезжал за кромку целиком, на 900 — на 908. Отступы базового правила
       снимаются явно: у относительного элемента они сдвигают его самого. */
    .switch {
      position: relative;
      inset-inline-start: auto;
      inset-block-start: auto;
      translate: none;
      margin-inline-start: var(--space-2xs);
      margin-block-end: var(--space-xl);
    }

    /* Раскрывается вниз, а не вправо: справа от иконки на узком экране остаётся
       меньше его собственной ширины. Потолок — колонка страницы за вычетом того
       же поля, на которое отбита сама иконка: `max-content` не знает про кромку
       экрана и вылез бы за неё на своих кнопках. */
    .switch__pop {
      inset-inline-start: 0;
      inset-block-start: calc(100% + var(--space-2xs));
      translate: none;
      max-inline-size: calc(100vw - var(--margin) * 2 - var(--space-2xs));
    }

    /* Кнопки переносятся: в потолок они упираются раньше, чем кончается строка. */
    .switch__row {
      flex-wrap: wrap;
    }
  }

  @media (max-width: 560px) {
    .vote__actions {
      align-items: stretch;
    }

    .vote__cta {
      flex: 1;
      text-align: center;
    }
  }
</style>

<script>
  /**
   * Состояние блока, отсчёт и его анимация.
   *
   * Состояние держится в адресе (`?voting=during`), а не только в памяти
   * страницы: ссылкой на конкретный вариант можно поделиться, а перезагрузка не
   * сбрасывает выбор. Это временно — вместе с переключателем уйдёт и разбор
   * параметра.
   *
   * Анимация отсчёта — «набор»: у каждого знака своя лента из случайных цифр с
   * целевой в конце, и лента уезжает по Y в своей маске. Задержка идёт от старта
   * по знакам, поэтому число собирается слева направо, а не проявляется целиком.
   *
   * Едет именно позиция ленты, а не подменяется текст в кадре: подмена шагами
   * читалась мерцанием, а один `transform` с задержкой — движением, и его считает
   * компоузитор, а не JS. Своих кадров у набора поэтому нет вовсе.
   *
   * Ход у набора своё время, а не доля прокрутки: прокрутка даёт ровно одну
   * команду — «отсчёт впервые вошёл в кадр», — и приносит её `IntersectionObserver`,
   * после чего снимается. Своего слушателя скролла здесь нет: рядом с Lenis он был
   * бы вторым и на каждый кадр.
   *
   * Играется набор один раз за загрузку: отсчёт — показание, а не событие, и
   * пересобирать его при каждом проходе мимо блока значит объявлять изменение,
   * которого не было.
   */
  const STATES = ['before', 'during', 'after'];

  /* Ход ленты, задержка следующего знака от старта и длина ленты. Секунды, а не
     кадры: при 120 Гц кадры вдвое короче.

     Три числа связаны: лента проходит REEL знаков за ROLL, то есть скорость набора
     — это их отношение. На восьми знаках за 0.9 с цифры сливались в полосу, читать
     в ней было нечего. Хочешь быстрее — укорачивай ленту, а не режь ход.

     Задержка мелкая относительно хода (0.07 против 2.1): следующая цифра трогается
     почти сразу за предыдущей, и набор читается одним движением с оттяжкой. На
     задержке в 0.17 знаки шли поочерёдно, и число собиралось шестью отдельными
     событиями. */
  const ROLL = 2.1;
  const STAGGER = 0.07;
  const REEL = 6;

  const DIGITS = '0123456789';

  function mount() {
    const section = document.querySelector<HTMLElement>('[data-voting]');
    if (!section) return;
    /* Гард обязателен: `astro:page-load` приходит и на первой загрузке тоже, а
       второй проход завёл бы второй интервал отсчёта, второй наблюдатель на
       каждый таймер (набор проигрался бы дважды) и по второму слушателю на
       документ. */
    if (section.dataset.mounted) return;
    section.dataset.mounted = '1';

    const panels = Array.from(section.querySelectorAll<HTMLElement>('[data-voting-panel]'));
    const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-voting-set]'));
    const switcher = section.querySelector<HTMLElement>('[data-voting-switch]');
    const toggle = section.querySelector<HTMLButtonElement>('[data-voting-toggle]');
    const pop = section.querySelector<HTMLElement>('.switch__pop');

    // Переключатель поднимается скриптом: без JS его кнопки ничего не делают
    switcher?.removeAttribute('hidden');

    const setPop = (open: boolean) => {
      if (!pop || !toggle) return;
      pop.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };

    /* `hidden` в DOM больше не булев: у него есть значение `until-found`, и тип
       свойства — `boolean | 'until-found'`. Поэтому состояние снимается
       приведением, а не `?? false`: скрытый «до поиска» узел для переключателя
       тоже скрыт, и открыть его надо. */
    toggle?.addEventListener('click', () => setPop(Boolean(pop?.hidden)));
    // Закрытие по клику вне и по Escape: поп-ап лежит поверх содержимого, и
    // оставленный открытым он перекрывает блок.
    document.addEventListener('pointerdown', (e) => {
      if (!switcher || switcher.contains(e.target as Node)) return;
      setPop(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setPop(false);
    });

    const apply = (state: string) => {
      section.dataset.state = state;
      for (const p of panels) p.hidden = p.dataset.votingPanel !== state;
      for (const b of buttons) {
        b.setAttribute('aria-pressed', String(b.dataset.votingSet === state));
      }
      // Панель показана — её отсчёт набирается, если ещё не набирался: скрытая
      // панель на `IntersectionObserver` не отзывается вовсе, и без этого она
      // открылась бы с уже стоящими цифрами. Второй раз тот же отсчёт не играет —
      // за это отвечает сам `play`.
      for (const t of timers) if (!t.el.closest('[hidden]')) t.play();
    };

    // ── отсчёт ───────────────────────────────────────────────────────────────
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    type Cell = { reel: HTMLElement; items: number };
    type Timer = { el: HTMLElement; play(): void };

    const timers: Timer[] = [];

    for (const el of Array.from(section.querySelectorAll<HTMLElement>('[data-timer]'))) {
      const target = el.dataset.target || '';
      const at = target ? new Date(target).getTime() : NaN;
      const live = !Number.isNaN(at);

      const grid = el.querySelector<HTMLElement>('.timer__grid');
      const segs = Array.from(el.querySelectorAll<HTMLElement>('[data-timer-seg]'));
      let cells: Cell[] = [];

      /** Лента знака: случайные цифры и целевая последней. */
      const reelOf = (ch: string): Cell => {
        const box = document.createElement('span');
        box.className = 'timer__ch';
        const reel = document.createElement('span');
        reel.className = 'timer__reel';
        const items = /[0-9]/.test(ch) ? REEL + 1 : 1;
        for (let i = 0; i < items - 1; i += 1) {
          const it = document.createElement('span');
          // Цифры детерминированные, а не случайные: одинаковый набор при каждой
          // загрузке можно сверить скриншотом.
          it.textContent = DIGITS[(i * 7 + 3) % 10];
          reel.append(it);
        }
        const last = document.createElement('span');
        last.textContent = ch;
        reel.append(last);
        // Лента стоит сразу на целевой цифре: без набора отсчёт виден нормальным
        // числом, а сам набор только отматывает её к началу и отпускает.
        //
        // Шаг в `em`, а не в процентах, и это не вкус: процент у `translateY`
        // считается от высоты САМОЙ ленты, а она в девять знаков — `-800%`
        // уводило её на двадцать пять тысяч пикселей, то есть в пустоту. Знак
        // ростом ровно в `1em` (см. стили), поэтому `em` тут и есть номер знака.
        reel.style.transform = `translateY(${-(items - 1)}em)`;
        box.append(reel);
        return { reel, items };
      };

      const values = () => {
        if (!live) return { days: '--', hours: '--', minutes: '--' };
        const left = Math.max(0, at - Date.now());
        const minutes = Math.floor(left / 60000);
        return {
          days: String(Math.floor(minutes / 1440)).padStart(2, '0'),
          hours: String(Math.floor((minutes % 1440) / 60)).padStart(2, '0'),
          minutes: String(minutes % 60).padStart(2, '0'),
        };
      };

      /** Пересборка знаков. Дешевле переписать три числа, чем сверять по знакам:
          отсчёт обновляется раз в минуту, а не в кадре. */
      const build = () => {
        const v = values() as Record<string, string>;
        cells = [];
        let chars = 0;
        for (const seg of segs) {
          const value = v[seg.dataset.timerSeg!] ?? '--';
          chars += value.length;
          seg.textContent = '';
          for (const ch of value) {
            const cell = reelOf(ch);
            seg.append(cell.reel.parentElement!);
            cells.push(cell);
          }
        }
        // Кегль считается от числа знаков: у отсчёта дальше 99 дней их семь.
        if (grid) grid.style.setProperty('--chars', String(chars));

        const sr = el.querySelector<HTMLElement>('[data-timer-sr]');
        if (sr && live) {
          sr.textContent = `Осталось: ${v.days} дн. ${v.hours} ч. ${v.minutes} мин.`;
        }
      };

      build();
      // Раз в минуту: младший разряд отсчёта — минуты, чаще считать нечего. Набор
      // при этом не проигрывается — он про появление отсчёта, а не про каждое его
      // изменение.
      if (live) setInterval(build, 60_000);

      let played = false;

      const play = () => {
        // Набор играется один раз за загрузку — при первом появлении отсчёта. На
        // повторных проходах мимо блока цифры уже стоят: отсчёт не событие, а
        // показание, и заново набирать его при каждой прокрутке значит объявлять
        // изменение, которого не было.
        if (reduced || played) return;
        played = true;
        // Лента отматывается к началу без перехода...
        for (let i = 0; i < cells.length; i += 1) {
          const { reel, items } = cells[i];
          if (items < 2) continue;
          reel.style.transition = 'none';
          reel.style.transform = 'translateY(0)';
        }
        // ...и только после принудительного пересчёта отпускается к целевой цифре.
        // Чтение геометрии здесь обязательно: без него браузер склеивает оба
        // присваивания в одно, начальным состоянием перехода остаётся целевая
        // цифра, и движения нет вовсе — молча, без единой ошибки. Кадр
        // (`requestAnimationFrame`) на это не годится: он рассчитывает, что между
        // двумя записями будет отрисовка, а наблюдатель отдаёт первую запись не
        // внутри кадра — замер показывал набор, не проигравший ни одного шага.
        void el.offsetHeight;
        for (let i = 0; i < cells.length; i += 1) {
          const { reel, items } = cells[i];
          if (items < 2) continue;
          reel.style.transition = `transform ${ROLL}s var(--ease-expo) ${i * STAGGER}s`;
          reel.style.transform = `translateY(${-(items - 1)}em)`;
        }
      };

      timers.push({ el, play });

      // Скролл-триггер: набор идёт при первом появлении отсчёта в кадре, и на этом
      // наблюдатель снимается — сторожить второй проход ему больше незачем. Порог
      // по четверти высоты: метку в пиксель быстрый скролл проскакивает между
      // кадрами, и команда не приходит вовсе.
      const io = new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting) return;
          play();
          io.disconnect();
        },
        { threshold: 0.25 },
      );
      io.observe(el);
    }

    const fromUrl = new URL(location.href).searchParams.get('voting');
    if (fromUrl && STATES.includes(fromUrl)) apply(fromUrl);

    for (const b of buttons) {
      b.addEventListener('click', () => {
        const state = b.dataset.votingSet!;
        apply(state);
        const url = new URL(location.href);
        url.searchParams.set('voting', state);
        history.replaceState(null, '', url);
      });
    }
  }

  mount();
  document.addEventListener('astro:page-load', mount);
</script>
